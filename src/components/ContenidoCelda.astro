---
import AvisoConvocatoria from './AvisoConvocatoria.astro';
import IconoEstado from './IconoEstado.astro';
import { ESTADO_VISTA, TIPO_FUENTE, fecha, localizador, subtemasDe, urlPropuesta, type Datos } from '../lib/ui';
import type { Celda, Partido } from '../lib/modelo';

interface Props {
  celda: Celda | undefined;
  partido: Partido;
  fuente: Datos['fuente'];
}

const { celda, partido, fuente } = Astro.props;
const estado = celda?.data.estado ?? 'sin_revisar';
const revisado = celda && fecha(celda.data.revisado);
---

<div class="celda" data-estado={estado}>
  <p class="estado">
    <IconoEstado estado={estado} />
    <span>{ESTADO_VISTA[estado].etiqueta}</span>
  </p>
  {
    revisado && (
      <p class="revisado">
        Revisado: <time datetime={revisado.iso}>{revisado.texto}</time>
      </p>
    )
  }
  {
    celda && celda.data.propuestas.length > 0 && (
      <ul class="propuestas">
        {celda.data.propuestas.map((p) => {
          const f = fuente(p.fuente.id);
          const subtemas = subtemasDe(p);
          return (
            <li data-subtema={subtemas.join('|')}>
              {subtemas.length > 0 && <p class="subtema">{subtemas.join(' · ')}</p>}
              <p>{p.resumen}</p>
              {p.cita && (
                <p class="cita">
                  <q>{p.cita}</q>
                </p>
              )}
              <p class="fuente">
                Fuente:{' '}
                <a href={urlPropuesta(f, p.pagina)} rel="noopener">
                  {f.data.titulo}
                  <span class="sr-only"> ({partido.data.nombre_corto})</span>, {localizador(p.pagina)}
                </a>
                {f.data.tipo !== 'programa' && <> ({TIPO_FUENTE[f.data.tipo].toLowerCase()})</>}
              </p>
              <AvisoConvocatoria fuente={f} />
            </li>
          );
        })}
      </ul>
    )
  }
</div>

<style>
  .celda {
    display: grid;
    gap: var(--space-2);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .estado {
    display: inline-flex;
    align-items: flex-start;
    justify-self: start;
    gap: var(--space-2);
    padding: 0.3rem 0.65rem;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.35;
    background: var(--head);
    border-radius: 999px;
  }

  .estado :global(.icono) {
    margin-top: 0.1em;
  }

  [data-estado='completo'] .estado {
    color: var(--text);
  }

  [data-estado='parcial'] .estado {
    color: var(--parcial);
  }

  [data-estado='sin_propuesta'] .estado {
    color: var(--text);
    font-weight: 500;
  }

  [data-estado='no_publicado'] .estado,
  [data-estado='sin_revisar'] .estado {
    color: var(--pendiente);
    font-weight: 500;
  }

  .revisado {
    color: var(--muted);
    font-size: var(--step--2);
  }

  .propuestas {
    display: grid;
    margin-top: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .propuestas > li {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .propuestas > li:last-child {
    padding-bottom: 0;
  }

  .subtema {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cita {
    padding-left: var(--space-3);
    color: var(--muted);
    border-left: 2px solid var(--rule);
    font-style: italic;
  }

  .fuente {
    font-size: var(--step--2);
    color: var(--muted);
  }
</style>
