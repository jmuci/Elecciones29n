---
import '../styles/global.css';
import SelectorTema from '../components/SelectorTema.astro';
import SobreElAutor from '../components/SobreElAutor.astro';
import AvisoTestPendiente from '../components/AvisoTestPendiente.astro';
import { cargarDatos, fecha } from '../lib/ui';

interface Props {
  titulo: string;
  descripcion: string;
}

const { titulo, descripcion } = Astro.props;
const { celdas } = await cargarDatos();
const ultima = fecha(new Date(Math.max(...celdas.map((c) => c.data.revisado.getTime()))), true);
const ruta = Astro.url.pathname.replace(/\/+$/, '') || '/';
const enlaces = [
  { href: '/', texto: 'Propuestas' },
  { href: '/test', texto: 'Test' },
  { href: '/problemas', texto: 'Problemas de actualidad' },
  { href: '/historia', texto: 'Repaso histórico' },
  { href: '/encuestas', texto: 'Encuestas' },
  { href: '/fuentes', texto: 'Fuentes' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <title>{titulo}</title>
    <script is:inline>
      // Aplica el tema guardado antes del primer pintado (ver SelectorTema.astro).
      try {
        const t = localStorage.getItem('tema');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
      <div class="contenedor cabecera__fila">
        <a class="marca" href="/">
          <span class="marca__sello" aria-hidden="true">29N</span>
          <span class="marca__texto">Elecciones generales <span class="marca__anio">2026</span></span>
        </a>
        <nav aria-label="Principal">
          <ul>
            {
              enlaces.map(({ href, texto }) => (
                <li>
                  <a href={href} aria-current={ruta === href ? 'page' : undefined}>
                    {texto}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <SelectorTema />
      </div>
    </header>
    {/* En /test ya se ve el progreso en la barra del propio test. */}
    {ruta !== '/test' && <AvisoTestPendiente />}
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <SobreElAutor />
    <footer class="pie">
      <div class="contenedor pie__fila">
        <p class="pie__marca">
          <span class="marca__sello" aria-hidden="true">29N</span>
          Resúmenes propios; la fuente oficial siempre prevalece.
        </p>
        <p>
          Última actualización: <time datetime={ultima.iso}>{ultima.texto}</time>
        </p>
        <p>
          <a href="https://github.com/jmuci/Elecciones29n/issues/new?template=error-contenido.yml" rel="noopener">
            Reportar un error
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: var(--space-4);
    top: -100vh;
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    background: var(--surface);
    color: var(--link);
    border: 2px solid var(--focus);
    border-radius: var(--radius);
  }

  .saltar:focus {
    top: var(--space-4);
  }

  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(1.6) blur(12px);
    -webkit-backdrop-filter: saturate(1.6) blur(12px);
    border-bottom: 1px solid var(--rule);
  }

  .cabecera__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    min-height: var(--header-h);
    padding-block: var(--space-2);
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .marca__sello {
    display: inline-grid;
    place-items: center;
    padding: 0.2rem 0.45rem;
    background: var(--text);
    color: var(--bg);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .marca__anio {
    color: var(--muted);
    font-weight: 500;
  }

  /* La navegación se pega al selector de tema, a la derecha. */
  nav {
    margin-inline-start: auto;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color 0.15s, background-color 0.15s;
  }

  nav a:hover {
    color: var(--text);
    background: var(--head);
  }

  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--head);
    font-weight: 600;
  }

  /* Móvil: una sola fila (sello · navegación · tema); la navegación se desplaza en horizontal si no cabe. */
  @media (width < 40rem) {
    .cabecera__fila {
      flex-wrap: nowrap;
      gap: var(--space-3);
    }

    .marca__texto {
      display: none;
    }

    nav {
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }

    nav ul {
      flex-wrap: nowrap;
    }

    nav a {
      padding: 0 var(--space-2);
      white-space: nowrap;
    }
  }

  main {
    display: block;
    padding-block: var(--space-7) var(--space-8);
  }

  main:focus {
    outline: none;
  }

  .pie {
    border-top: 1px solid var(--rule);
    padding-block: var(--space-6);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .pie__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
  }

  .pie__marca {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-right: auto;
  }
</style>
