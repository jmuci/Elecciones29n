---
import '../styles/global.css';
import SelectorTema from '../components/SelectorTema.astro';
import SobreElAutor from '../components/SobreElAutor.astro';
import { cargarDatos, fecha } from '../lib/ui';

interface Props {
  titulo: string;
  descripcion: string;
}

const { titulo, descripcion } = Astro.props;
const { celdas } = await cargarDatos();
const ultima = fecha(new Date(Math.max(...celdas.map((c) => c.data.revisado.getTime()))), true);
const ruta = Astro.url.pathname.replace(/\/+$/, '') || '/';
const enlaces = [
  { href: '/', texto: 'Propuestas' },
  { href: '/test', texto: 'Test' },
  { href: '/historia', texto: 'Historia' },
  { href: '/encuestas', texto: 'Encuestas' },
  { href: '/fuentes', texto: 'Fuentes' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <title>{titulo}</title>
    <script is:inline>
      // Aplica el tema guardado antes del primer pintado (ver SelectorTema.astro).
      try {
        const t = localStorage.getItem('tema');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
      <div class="contenedor cabecera__fila">
        <a class="marca" href="/">Elecciones 29-N · 2026</a>
        <nav aria-label="Principal">
          <ul>
            {
              enlaces.map(({ href, texto }) => (
                <li>
                  <a href={href} aria-current={ruta === href ? 'page' : undefined}>
                    {texto}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <SelectorTema />
      </div>
    </header>
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <SobreElAutor />
    <footer class="pie">
      <div class="contenedor">
        <p>
          Resúmenes propios; la fuente oficial siempre prevalece. Última actualización:{' '}
          <time datetime={ultima.iso}>{ultima.texto}</time>.
        </p>
        <p>
          <a href="https://github.com/jmuci/Elecciones29n/issues/new?template=error-contenido.yml" rel="noopener">
            Reportar un error
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: var(--space-4);
    top: -100vh;
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    background: var(--surface);
    color: var(--link);
    border: 2px solid var(--focus);
    border-radius: var(--radius);
  }

  .saltar:focus {
    top: var(--space-4);
  }

  .cabecera {
    border-bottom: 1px solid var(--rule);
  }

  /* Estrecho: marca y tema arriba, navegación debajo. Ancho: marca · navegación · tema. */
  .cabecera__fila {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'marca tema'
      'nav nav';
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-4);
  }

  nav {
    grid-area: nav;
  }

  .cabecera__fila > :global(.tema) {
    grid-area: tema;
  }

  @media (min-width: 52rem) {
    .cabecera__fila {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'marca nav tema';
      column-gap: var(--space-5);
    }

    nav ul {
      justify-content: flex-end;
    }
  }

  .marca {
    grid-area: marca;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 600;
    text-decoration: none;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--text);
    text-decoration: none;
    padding-block: var(--space-1);
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    border-bottom-color: var(--border-strong);
  }

  nav a[aria-current='page'] {
    border-bottom-color: var(--text);
    font-weight: 600;
  }

  main {
    display: block;
    padding-block: var(--space-6) var(--space-7);
  }

  main:focus {
    outline: none;
  }

  .pie {
    border-top: 1px solid var(--rule);
    padding-block: var(--space-5);
    color: var(--muted);
    font-size: var(--step--1);
  }
</style>
