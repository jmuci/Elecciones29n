---
import Base from '../layouts/Base.astro';
import ContenidoCelda from '../components/ContenidoCelda.astro';
import InfoPartido from '../components/InfoPartido.astro';
import Leyenda from '../components/Leyenda.astro';
import { cargarDatos, subtemasDe } from '../lib/ui';
import type { Tema } from '../lib/modelo';

const MAX_COMPARAR = 3;
const { partidos, temas, temasMostrados, celda, fuente } = await cargarDatos();
const faltanCeldas = temasMostrados.some((t) => partidos.some((p) => !celda(p.id, t.id)));

/** Partidos con al menos una propuesta en el tema (para el resumen de cada sección). */
const conPropuestas = (tema: string): number =>
  partidos.filter((p) => (celda(p.id, tema)?.data.propuestas.length ?? 0) > 0).length;

/** Subtemas del tema que usa al menos una propuesta, en el orden de `temas/<tema>.yaml`. */
const subtemasUsados = (tema: Tema): string[] => {
  const usados = new Set(partidos.flatMap((p) => (celda(p.id, tema.id)?.data.propuestas ?? []).flatMap(subtemasDe)));
  return tema.data.subtemas.filter((s) => usados.has(s));
};
---

<Base
  titulo="Elecciones 29-N-2026 · Comparador de propuestas"
  descripcion="Propuestas de los partidos para las elecciones generales del 29 de noviembre de 2026, tema a tema y con enlace a la fuente oficial."
>
  <div class="contenedor intro">
    <div class="prosa">
      <h1>Qué propone cada partido, tema a tema</h1>
      <p class="entradilla">
        Resumen de las propuestas para las elecciones generales del 29 de noviembre de 2026. Cada propuesta enlaza al
        documento oficial del partido, con su página o sección.
      </p>
      <p>
        Despliega un tema para ver las propuestas de cada partido. Los partidos aparecen siempre en el mismo orden: por
        escaños obtenidos en las generales de julio de 2023, y los partidos nuevos al final. Junto a cada nombre se indica
        dónde se presenta. Por ahora se muestran {temasMostrados.length} de {temas.length} temas; el resto se irá añadiendo.
      </p>
    </div>
    <Leyenda conSinRevisar={faltanCeldas} />
  </div>

  {
    temasMostrados.length === 0 ? (
      <p class="contenedor vacio">Aún no hay temas revisados.</p>
    ) : (
      <div class="contenedor temas" id="temas">
        <nav class="indice" aria-labelledby="indice-titulo">
          <h2 id="indice-titulo">Temas</h2>
          <ul>
            {temasMostrados.map((t) => (
              <li>
                <a href={`#${t.id}`} data-tema={t.id}>
                  {t.data.nombre}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <form class="controles" id="controles" hidden>
          <fieldset class="control">
            <legend>Comparar partidos</legend>
            <p class="ayuda" id="ayuda-comparar">
              Elige hasta {MAX_COMPARAR}; en pantallas anchas se muestran en columnas. Si no marcas ninguno, se muestran
              todos. La dirección de la página guarda la selección para compartirla.
            </p>
            <ul class="opciones">
              {partidos.map((p) => (
                <li>
                  <label>
                    <input
                      type="checkbox"
                      name="partido"
                      value={p.id}
                      aria-describedby="ayuda-comparar estado-comparar"
                    />
                    {p.data.nombre_corto}
                    {p.data.ficticio && <span class="marca-prueba">FICTICIO</span>}
                  </label>
                </li>
              ))}
            </ul>
            <p class="ayuda" id="estado-comparar" role="status" data-max={MAX_COMPARAR} data-total={partidos.length} />
          </fieldset>
          <div class="acciones">
            <button type="button" data-accion="abrir">Desplegar todos los temas</button>
            <button type="button" data-accion="cerrar">Plegar todos</button>
          </div>
        </form>

        {temasMostrados.map((t) => {
          const lista = subtemasUsados(t);
          return (
            <details class="tema" id={t.id}>
              <summary>
                <h2>{t.data.nombre}</h2>
                <span class="resumen">
                  {conPropuestas(t.id)} de {partidos.length} partidos con propuestas
                </span>
              </summary>
              <div class="cuerpo">
                {t.data.descripcion && <p class="descripcion">{t.data.descripcion}</p>}
                {lista.length > 1 && (
                  <fieldset class="filtro-subtema" hidden>
                    <legend>Filtrar por subtema</legend>
                    <div class="chips">
                      <label>
                        <input type="radio" name={`subtema-${t.id}`} value="" checked />
                        Todos
                      </label>
                      {lista.map((s) => (
                        <label>
                          <input type="radio" name={`subtema-${t.id}`} value={s} />
                          {s}
                        </label>
                      ))}
                    </div>
                    <p class="ayuda">
                      Los subtemas son una clasificación propia de esta web; una propuesta puede tener varios.
                    </p>
                  </fieldset>
                )}
                <ol class="partidos">
                  {partidos.map((p) => (
                    <li class="partido" data-partido={p.id}>
                      <section aria-labelledby={`${t.id}-${p.id}`}>
                        <header>
                          <h3 id={`${t.id}-${p.id}`}>{p.data.nombre_corto}</h3>
                          <InfoPartido partido={p} />
                        </header>
                        <ContenidoCelda celda={celda(p.id, t.id)} partido={p} fuente={fuente} />
                        <p class="sin-subtema" hidden>
                          Ninguna de las propuestas recogidas de este partido está clasificada en este subtema.
                        </p>
                      </section>
                    </li>
                  ))}
                </ol>
              </div>
            </details>
          );
        })}
      </div>
    )
  }
</Base>

<script>
  const contenedor = document.querySelector<HTMLElement>('#temas');
  const form = document.querySelector<HTMLFormElement>('#controles');
  const estado = document.querySelector<HTMLElement>('#estado-comparar');
  const temas = [...document.querySelectorAll<HTMLDetailsElement>('details.tema')];

  // — Abrir temas desde el índice o desde un enlace con #id (p. ej. /#vivienda) —

  const abrir = (id: string): void => {
    const tema = temas.find((t) => t.id === id);
    if (!tema) return;
    tema.open = true;
    tema.scrollIntoView();
    tema.querySelector('summary')?.focus({ preventScroll: true });
  };
  abrir(decodeURIComponent(location.hash.slice(1)));
  window.addEventListener('hashchange', () => abrir(decodeURIComponent(location.hash.slice(1))));
  // Si el hash ya es el del tema (p. ej. se plegó después), hashchange no salta: se abre igual.
  document.querySelector('.indice')?.addEventListener('click', (e) => {
    const id = e.target instanceof HTMLAnchorElement ? e.target.dataset.tema : undefined;
    if (id && location.hash === `#${id}`) abrir(id);
  });

  // — Al imprimir se muestran todos los temas; después se restaura el estado —

  let abiertos: boolean[] = [];
  window.addEventListener('beforeprint', () => {
    abiertos = temas.map((t) => t.open);
    for (const t of temas) t.open = true;
  });
  window.addEventListener('afterprint', () => temas.forEach((t, i) => (t.open = abiertos[i] ?? false)));

  // — Filtro por subtema (uno por tema) —

  for (const tema of temas) {
    const filtro = tema.querySelector<HTMLFieldSetElement>('.filtro-subtema');
    if (!filtro) continue;
    filtro.addEventListener('change', () => {
      const elegido = filtro.querySelector<HTMLInputElement>('input:checked')?.value ?? '';
      for (const partido of tema.querySelectorAll<HTMLElement>('.partido')) {
        const propuestas = [...partido.querySelectorAll<HTMLElement>('li[data-subtema]')];
        for (const p of propuestas) p.hidden = elegido !== '' && !(p.dataset.subtema ?? '').split('|').includes(elegido);
        const aviso = partido.querySelector<HTMLElement>('.sin-subtema');
        // Solo para partidos con propuestas: sin ellas ya se muestra su estado (p. ej. pendiente de publicación).
        if (aviso) aviso.hidden = elegido === '' || propuestas.length === 0 || propuestas.some((p) => !p.hidden);
      }
    });
    filtro.hidden = false;
  }

  // — Comparar partidos, con la selección guardada en ?partidos=pp,psoe —

  if (contenedor && form && estado) {
    const max = Number(estado.dataset.max);
    const total = Number(estado.dataset.total);
    const casillas = [...form.querySelectorAll<HTMLInputElement>('input[name="partido"]')];
    const bloques = [...document.querySelectorAll<HTMLElement>('details.tema .partido')];

    const marcados = (): string[] => casillas.filter((c) => c.checked).map((c) => c.value);

    const guardarEnUrl = (elegidos: string[]): void => {
      const params = new URLSearchParams(location.search);
      params.delete('partidos');
      const resto = params.toString();
      const query = [resto, elegidos.length > 0 ? `partidos=${elegidos.join(',')}` : ''].filter(Boolean).join('&');
      history.replaceState(null, '', `${location.pathname}${query ? `?${query}` : ''}${location.hash}`);
    };

    const aplicar = (aviso?: string): void => {
      const elegidos = marcados();
      for (const b of bloques) b.hidden = elegidos.length > 0 && !elegidos.includes(b.dataset.partido ?? '');
      contenedor.dataset.comparando = String(elegidos.length);
      const n = elegidos.length || total;
      estado.textContent = aviso ?? `Se muestran ${n} de ${total} partidos.`;
      guardarEnUrl(elegidos);
    };

    // Selección inicial desde la URL: solo ids existentes y como mucho `max`.
    const desdeUrl = (new URLSearchParams(location.search).get('partidos') ?? '').split(',');
    const validos = casillas.filter((c) => desdeUrl.includes(c.value)).slice(0, max);
    for (const c of validos) c.checked = true;

    form.addEventListener('change', (e) => {
      const c = e.target;
      if (!(c instanceof HTMLInputElement) || c.name !== 'partido') return;
      if (c.checked && marcados().length > max) {
        c.checked = false;
        aplicar(`Ya hay ${max} partidos elegidos, el máximo. Desmarca uno para elegir otro.`);
        return;
      }
      aplicar();
    });
    form.addEventListener('click', (e) => {
      const accion = e.target instanceof HTMLButtonElement ? e.target.dataset.accion : undefined;
      if (accion) for (const t of temas) t.open = accion === 'abrir';
    });
    form.addEventListener('submit', (e) => e.preventDefault());

    form.hidden = false;
    aplicar();
  }
</script>

<style>
  .intro {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }

  h1 {
    font-size: var(--step-3);
    letter-spacing: -0.01em;
  }

  .entradilla {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .vacio {
    color: var(--muted);
  }

  .temas {
    display: grid;
    gap: var(--space-4);
  }

  .ayuda {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .ayuda:empty {
    display: none;
  }

  /* — Índice de temas — */

  .indice h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-3);
  }

  .indice ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .indice a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
  }

  /* — Controles — */

  .controles {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-4);
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .controles[hidden],
  .filtro-subtema[hidden] {
    display: none;
  }

  .control,
  .filtro-subtema {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  legend {
    padding: 0;
    font-weight: 600;
  }

  .opciones {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-1) var(--space-4);
    padding: 0;
    list-style: none;
  }

  .opciones label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    cursor: pointer;
  }

  input[type='checkbox'] {
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    accent-color: var(--link);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  button {
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-4);
    font: inherit;
    color: var(--link);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    cursor: pointer;
  }

  /* — Temas desplegables — */

  .tema {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    scroll-margin-top: var(--space-4);
  }

  summary {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Indicador propio: flecha a la derecha plegado, hacia abajo desplegado. */
  summary::before {
    content: '';
    grid-row: 1;
    align-self: center;
    width: 0.6rem;
    height: 0.6rem;
    margin-right: var(--space-1);
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(-45deg);
    transition: transform 0.15s;
  }

  .tema[open] > summary::before {
    transform: rotate(45deg);
  }

  summary:hover h2 {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .tema[open] > summary {
    border-bottom: 1px solid var(--rule);
  }

  summary h2 {
    font-size: var(--step-2);
    line-height: 1.2;
  }

  .resumen {
    grid-column: 2;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .cuerpo {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
  }

  .descripcion {
    max-width: var(--measure);
    color: var(--muted);
  }

  /* — Filtro por subtema — */

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chips label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    cursor: pointer;
  }

  .chips label:has(input:checked) {
    font-weight: 600;
    background: var(--head);
  }

  .chips input {
    margin: 0;
    accent-color: var(--link);
  }

  .partido :global(li[hidden]),
  .sin-subtema[hidden] {
    display: none;
  }

  .sin-subtema {
    color: var(--muted);
    font-size: var(--step--1);
  }

  /* — Partidos dentro de cada tema — */

  .partidos {
    display: grid;
    gap: var(--space-6);
    max-width: var(--measure);
    padding: 0;
    list-style: none;
  }

  .partido[hidden] {
    display: none;
  }

  .partido + .partido {
    padding-top: var(--space-6);
    border-top: 1px solid var(--rule);
  }

  .partido section {
    display: grid;
    gap: var(--space-3);
  }

  .partido header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
  }

  .partido h3 {
    font-family: var(--font-serif);
    font-size: var(--step-1);
  }

  /* Comparación lado a lado: 2 o 3 partidos elegidos, en pantallas anchas. */
  @media (width >= 64rem) {
    .temas[data-comparando='2'] .partidos,
    .temas[data-comparando='3'] .partidos {
      grid-template-columns: repeat(var(--columnas), minmax(0, 1fr));
      align-items: start;
      max-width: none;
    }

    .temas[data-comparando='2'] {
      --columnas: 2;
    }

    .temas[data-comparando='3'] {
      --columnas: 3;
    }

    .temas[data-comparando='2'] .partido,
    .temas[data-comparando='3'] .partido {
      padding: var(--space-4);
      border: 1px solid var(--rule);
      border-radius: var(--radius);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    summary::before {
      transition: none;
    }
  }

  @media print {
    .controles,
    .indice,
    .filtro-subtema {
      display: none;
    }
  }
</style>
