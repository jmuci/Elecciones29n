---
import Base from '../layouts/Base.astro';
import ContenidoCelda from '../components/ContenidoCelda.astro';
import InfoPartido from '../components/InfoPartido.astro';
import Leyenda from '../components/Leyenda.astro';
import { cargarDatos, subtemasDe } from '../lib/ui';
import type { Tema } from '../lib/modelo';

const MAX_COMPARAR = 3;
const { partidos, temas, temasMostrados, celda, celdas, fuente, fuentes } = await cargarDatos();
const faltanCeldas = temasMostrados.some((t) => partidos.some((p) => !celda(p.id, t.id)));
const totalPropuestas = celdas.reduce((n, c) => n + c.data.propuestas.length, 0);
const numero = new Intl.NumberFormat('es-ES');

/** Partidos con al menos una propuesta en el tema (para el resumen de cada sección). */
const conPropuestas = (tema: string): number =>
  partidos.filter((p) => (celda(p.id, tema)?.data.propuestas.length ?? 0) > 0).length;

/** Subtemas del tema que usa al menos una propuesta, en el orden de `temas/<tema>.yaml`. */
const subtemasUsados = (tema: Tema): string[] => {
  const usados = new Set(partidos.flatMap((p) => (celda(p.id, tema.id)?.data.propuestas ?? []).flatMap(subtemasDe)));
  return tema.data.subtemas.filter((s) => usados.has(s));
};
---

<Base
  titulo="Elecciones 29-N-2026 · Comparador de propuestas"
  descripcion="Propuestas de los partidos para las elecciones generales del 29 de noviembre de 2026, tema a tema y con enlace a la fuente oficial."
>
  <div class="contenedor intro">
    <div class="hero">
      <p class="antetitulo">
        Elecciones generales · <time datetime="2026-11-29">29 de noviembre de 2026</time>
        <span class="cuenta" data-fecha="2026-11-29" hidden></span>
      </p>
      <h1>Qué propone cada partido, tema a tema</h1>
      <p class="entradilla">
        Resumen de las propuestas para las elecciones generales del 29 de noviembre de 2026. Cada propuesta enlaza al
        documento oficial del partido, con su página o sección.
      </p>
      <p class="cta">
        <a class="boton boton--primario" href="#temas">Ver los temas</a>
        <a class="boton" href="/test">Hacer el test de afinidad</a>
      </p>
    </div>

    <dl class="cifras">
      <div>
        <dt>Partidos</dt>
        <dd>{partidos.length}</dd>
      </div>
      <div>
        <dt>Temas</dt>
        <dd>
          {temasMostrados.length}
          {temasMostrados.length < temas.length && <span class="cifras__de">de {temas.length}</span>}
        </dd>
      </div>
      <div>
        <dt>Propuestas</dt>
        <dd>{numero.format(totalPropuestas)}</dd>
      </div>
      <div>
        <dt>Fuentes oficiales</dt>
        <dd>{fuentes.length}</dd>
      </div>
    </dl>

    <details class="como-leer">
      <summary>Cómo leer esta web</summary>
      <div class="como-leer__cuerpo">
        <p class="prosa">
          Despliega un tema para ver las propuestas de cada partido. Junto a cada nombre se indica dónde se presenta.
          {temasMostrados.length < temas.length && (
            <>
              Por ahora se muestran {temasMostrados.length} de {temas.length} temas; el resto se irá añadiendo.
            </>
          )}
        </p>
        <Leyenda conSinRevisar={faltanCeldas} />
      </div>
    </details>
  </div>

  {
    temasMostrados.length === 0 ? (
      <p class="contenedor vacio">Aún no hay temas revisados.</p>
    ) : (
      <div class="contenedor temas" id="temas">
        <nav class="indice" aria-labelledby="indice-titulo">
          <div class="indice__cabecera">
            <h2 id="indice-titulo">Temas</h2>
            <p class="ayuda">
              Los partidos aparecen siempre en el mismo orden: por escaños obtenidos en las generales de julio de 2023, y
              los partidos nuevos al final.
            </p>
          </div>
          <ul>
            {temasMostrados.map((t) => {
              const n = conPropuestas(t.id);
              return (
                <li>
                  <a href={`#${t.id}`} data-tema={t.id}>
                    <span class="indice__nombre">{t.data.nombre}</span>
                    <span class="cobertura" aria-hidden="true">
                      {partidos.map((_, i) => (
                        <span class:list={['cobertura__tramo', { lleno: i < n }]} />
                      ))}
                    </span>
                    <span class="indice__resumen">
                      {n} de {partidos.length} partidos con propuestas
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

        <form class="controles" id="controles" hidden>
          <fieldset class="control">
            <legend>Comparar partidos</legend>
            <p class="ayuda" id="ayuda-comparar">
              Elige hasta {MAX_COMPARAR}; en pantallas anchas se muestran en columnas. Si no marcas ninguno, se muestran
              todos. La dirección de la página guarda la selección para compartirla.
            </p>
            <ul class="opciones">
              {partidos.map((p) => (
                <li>
                  <label>
                    <input
                      type="checkbox"
                      name="partido"
                      value={p.id}
                      aria-describedby="ayuda-comparar estado-comparar"
                    />
                    {p.data.nombre_corto}
                    {p.data.ficticio && <span class="marca-prueba">FICTICIO</span>}
                  </label>
                </li>
              ))}
            </ul>
            <p class="ayuda" id="estado-comparar" role="status" data-max={MAX_COMPARAR} data-total={partidos.length} />
          </fieldset>
          <div class="acciones">
            <button class="boton" type="button" data-accion="abrir">Desplegar todos los temas</button>
            <button class="boton" type="button" data-accion="cerrar">Plegar todos</button>
          </div>
        </form>

        {temasMostrados.map((t) => {
          const lista = subtemasUsados(t);
          return (
            <details class="tema" id={t.id}>
              <summary>
                <h2>{t.data.nombre}</h2>
                <span class="resumen">
                  {conPropuestas(t.id)} de {partidos.length} partidos con propuestas
                </span>
                <span class="chevron" aria-hidden="true" />
              </summary>
              <div class="cuerpo">
                {t.data.descripcion && <p class="descripcion">{t.data.descripcion}</p>}
                {lista.length > 1 && (
                  <fieldset class="filtro-subtema" hidden>
                    <legend>Filtrar por subtema</legend>
                    <div class="chips">
                      <label>
                        <input type="radio" name={`subtema-${t.id}`} value="" checked />
                        Todos
                      </label>
                      {lista.map((s) => (
                        <label>
                          <input type="radio" name={`subtema-${t.id}`} value={s} />
                          {s}
                        </label>
                      ))}
                    </div>
                    <p class="ayuda">
                      Los subtemas son una clasificación propia de esta web; una propuesta puede tener varios.
                    </p>
                  </fieldset>
                )}
                <ol class="partidos">
                  {partidos.map((p) => (
                    <li class="partido" data-partido={p.id}>
                      <section aria-labelledby={`${t.id}-${p.id}`}>
                        <header>
                          <h3 id={`${t.id}-${p.id}`}>{p.data.nombre_corto}</h3>
                          <InfoPartido partido={p} />
                        </header>
                        <ContenidoCelda celda={celda(p.id, t.id)} partido={p} fuente={fuente} />
                        <p class="sin-subtema" hidden>
                          Ninguna de las propuestas recogidas de este partido está clasificada en este subtema.
                        </p>
                      </section>
                    </li>
                  ))}
                </ol>
              </div>
            </details>
          );
        })}
      </div>
    )
  }
</Base>

<script>
  // — Cuenta atrás hasta el día de la votación (solo antes de esa fecha) —

  const cuenta = document.querySelector<HTMLElement>('.cuenta');
  if (cuenta?.dataset.fecha) {
    const hoy = new Date();
    const dia = new Date(`${cuenta.dataset.fecha}T00:00:00`);
    const dias = Math.round((dia.getTime() - new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate()).getTime()) / 864e5);
    if (dias >= 0) {
      cuenta.textContent = dias === 0 ? 'Hoy se vota' : dias === 1 ? 'Falta 1 día' : `Faltan ${dias} días`;
      cuenta.hidden = false;
    }
  }

  const contenedor = document.querySelector<HTMLElement>('#temas');
  const form = document.querySelector<HTMLFormElement>('#controles');
  const estado = document.querySelector<HTMLElement>('#estado-comparar');
  const temas = [...document.querySelectorAll<HTMLDetailsElement>('details.tema')];

  // — Abrir temas desde el índice o desde un enlace con #id (p. ej. /#vivienda) —

  const abrir = (id: string): void => {
    const tema = temas.find((t) => t.id === id);
    if (!tema) return;
    tema.open = true;
    tema.scrollIntoView();
    tema.querySelector('summary')?.focus({ preventScroll: true });
  };
  abrir(decodeURIComponent(location.hash.slice(1)));
  window.addEventListener('hashchange', () => abrir(decodeURIComponent(location.hash.slice(1))));
  // Si el hash ya es el del tema (p. ej. se plegó después), hashchange no salta: se abre igual.
  document.querySelector('.indice')?.addEventListener('click', (e) => {
    const id = e.target instanceof HTMLAnchorElement ? e.target.dataset.tema : undefined;
    if (id && location.hash === `#${id}`) abrir(id);
  });

  // — Al imprimir se muestran todos los temas; después se restaura el estado —

  let abiertos: boolean[] = [];
  window.addEventListener('beforeprint', () => {
    abiertos = temas.map((t) => t.open);
    for (const t of temas) t.open = true;
  });
  window.addEventListener('afterprint', () => temas.forEach((t, i) => (t.open = abiertos[i] ?? false)));

  // — Filtro por subtema (uno por tema) —

  for (const tema of temas) {
    const filtro = tema.querySelector<HTMLFieldSetElement>('.filtro-subtema');
    if (!filtro) continue;
    filtro.addEventListener('change', () => {
      const elegido = filtro.querySelector<HTMLInputElement>('input:checked')?.value ?? '';
      for (const partido of tema.querySelectorAll<HTMLElement>('.partido')) {
        const propuestas = [...partido.querySelectorAll<HTMLElement>('li[data-subtema]')];
        for (const p of propuestas) p.hidden = elegido !== '' && !(p.dataset.subtema ?? '').split('|').includes(elegido);
        const aviso = partido.querySelector<HTMLElement>('.sin-subtema');
        // Solo para partidos con propuestas: sin ellas ya se muestra su estado (p. ej. pendiente de publicación).
        if (aviso) aviso.hidden = elegido === '' || propuestas.length === 0 || propuestas.some((p) => !p.hidden);
      }
    });
    filtro.hidden = false;
  }

  // — Comparar partidos, con la selección guardada en ?partidos=pp,psoe —

  if (contenedor && form && estado) {
    const max = Number(estado.dataset.max);
    const total = Number(estado.dataset.total);
    const casillas = [...form.querySelectorAll<HTMLInputElement>('input[name="partido"]')];
    const bloques = [...document.querySelectorAll<HTMLElement>('details.tema .partido')];

    const marcados = (): string[] => casillas.filter((c) => c.checked).map((c) => c.value);

    const guardarEnUrl = (elegidos: string[]): void => {
      const params = new URLSearchParams(location.search);
      params.delete('partidos');
      const resto = params.toString();
      const query = [resto, elegidos.length > 0 ? `partidos=${elegidos.join(',')}` : ''].filter(Boolean).join('&');
      history.replaceState(null, '', `${location.pathname}${query ? `?${query}` : ''}${location.hash}`);
    };

    const aplicar = (aviso?: string): void => {
      const elegidos = marcados();
      for (const b of bloques) b.hidden = elegidos.length > 0 && !elegidos.includes(b.dataset.partido ?? '');
      contenedor.dataset.comparando = String(elegidos.length);
      const n = elegidos.length || total;
      estado.textContent = aviso ?? `Se muestran ${n} de ${total} partidos.`;
      guardarEnUrl(elegidos);
    };

    // Selección inicial desde la URL: solo ids existentes y como mucho `max`.
    const desdeUrl = (new URLSearchParams(location.search).get('partidos') ?? '').split(',');
    const validos = casillas.filter((c) => desdeUrl.includes(c.value)).slice(0, max);
    for (const c of validos) c.checked = true;

    form.addEventListener('change', (e) => {
      const c = e.target;
      if (!(c instanceof HTMLInputElement) || c.name !== 'partido') return;
      if (c.checked && marcados().length > max) {
        c.checked = false;
        aplicar(`Ya hay ${max} partidos elegidos, el máximo. Desmarca uno para elegir otro.`);
        return;
      }
      aplicar();
    });
    form.addEventListener('click', (e) => {
      const accion = e.target instanceof HTMLButtonElement ? e.target.dataset.accion : undefined;
      if (accion) for (const t of temas) t.open = accion === 'abrir';
    });
    form.addEventListener('submit', (e) => e.preventDefault());

    form.hidden = false;
    aplicar();
  }
</script>

<style>
  /* — Cabecera de la portada — */

  .intro {
    display: grid;
    gap: var(--space-7);
    margin-bottom: var(--space-8);
  }

  .hero {
    display: grid;
    gap: var(--space-5);
    max-width: 52rem;
  }

  .hero .antetitulo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .cuenta {
    padding: 0.1rem 0.5rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  .cuenta[hidden] {
    display: none;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .boton--primario {
    color: var(--bg);
    background: var(--text);
    border-color: var(--text);
  }

  .boton--primario:hover {
    color: var(--bg);
    background: color-mix(in srgb, var(--text) 85%, var(--bg));
    border-color: transparent;
  }

  /* Cifras clave en una franja con separadores. */
  .cifras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .cifras > div {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-1);
    padding: var(--space-5);
    background: var(--surface);
  }

  .cifras dt {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .cifras dd {
    margin: 0;
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .cifras__de {
    color: var(--muted);
    font-size: var(--step-0);
    font-weight: 500;
    letter-spacing: 0;
  }

  /* — Cómo leer esta web — */

  .como-leer {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .como-leer > summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 3rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .como-leer > summary::-webkit-details-marker {
    display: none;
  }

  .como-leer > summary::before {
    content: '+';
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    font-family: var(--font-mono);
    color: var(--muted);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    line-height: 1;
  }

  .como-leer[open] > summary::before {
    content: '−';
  }

  .como-leer__cuerpo {
    display: grid;
    gap: var(--space-5);
    padding-bottom: var(--space-5);
    color: var(--muted);
  }

  .vacio {
    color: var(--muted);
  }

  .temas {
    display: grid;
    gap: var(--space-3);
  }

  .ayuda {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .ayuda:empty {
    display: none;
  }

  /* — Índice de temas — */

  .indice {
    margin-bottom: var(--space-6);
  }

  .indice__cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    margin-bottom: var(--space-5);
  }

  .indice__cabecera .ayuda {
    max-width: 40rem;
  }

  .indice h2 {
    font-size: var(--step-2);
  }

  .indice ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .indice a {
    display: grid;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-4);
    color: var(--text);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }

  .indice a:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-hover);
    transform: translateY(-1px);
  }

  .indice__nombre {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .indice__resumen {
    color: var(--muted);
    font-size: var(--step--2);
  }

  /* Barra de cobertura: un tramo por partido con propuestas; no identifica a ninguno. */
  .cobertura {
    display: flex;
    gap: 3px;
  }

  .cobertura__tramo {
    flex: 1;
    height: 4px;
    background: var(--rule);
    border-radius: 2px;
  }

  .cobertura__tramo.lleno {
    background: var(--text);
  }

  /* — Controles — */

  .controles {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-5);
    margin-bottom: var(--space-3);
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .controles[hidden],
  .filtro-subtema[hidden] {
    display: none;
  }

  .control,
  .filtro-subtema {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  legend {
    padding: 0;
    margin-bottom: var(--space-2);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .control .ayuda:first-of-type {
    display: none;
  }

  .opciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .opciones label,
  .chips label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    padding: 0 var(--space-3);
    font-size: var(--step--1);
    font-weight: 500;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.15s, background-color 0.15s, color 0.15s;
  }

  .opciones label:hover,
  .chips label:hover {
    border-color: var(--border-strong);
  }

  .opciones label:has(input:checked),
  .chips label:has(input:checked) {
    color: var(--bg);
    background: var(--text);
    border-color: var(--text);
  }

  .opciones label:has(:focus-visible),
  .chips label:has(:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .opciones input,
  .chips input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    margin: 0;
  }

  .opciones input:focus-visible,
  .chips input:focus-visible {
    outline: none;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* — Temas desplegables — */

  .tema {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: border-color 0.15s;
  }

  .tema:hover,
  .tema[open] {
    border-color: var(--border-strong);
  }

  .tema[open] {
    border-color: var(--rule);
  }

  summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Indicador propio, a la derecha: hacia abajo plegado, hacia arriba desplegado. */
  .chevron {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
  }

  .chevron::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    margin-top: -0.2rem;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: rotate(45deg);
    transition: transform 0.2s;
  }

  .tema[open] .chevron::before {
    margin-top: 0.2rem;
    transform: rotate(-135deg);
  }

  .tema[open] > summary {
    border-bottom: 1px solid var(--rule);
  }

  summary h2 {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .resumen {
    color: var(--muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  @media (width < 40rem) {
    summary {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .resumen {
      grid-row: 2;
    }

    .chevron {
      grid-row: 1 / span 2;
      grid-column: 2;
    }
  }

  .cuerpo {
    display: grid;
    gap: var(--space-6);
