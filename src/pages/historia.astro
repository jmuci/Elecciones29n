---
import Base from '../layouts/Base.astro';
import LineaTiempo from '../components/LineaTiempo.astro';
import GraficoCorrupcion from '../components/GraficoCorrupcion.astro';
import { resumirCorrupcion } from '../lib/corrupcion';
import { BLOQUE_VISTA, cargarHistoria, fecha, periodo, TIPO_FUENTE_HISTORIA } from '../lib/ui';

const { gobiernos, casos, recuentos, partidos } = await cargarHistoria();

const nombreCorto = (id: string): string => partidos.get(id)?.data.nombre_corto ?? id;
const etiquetaPartido = (c: (typeof casos)[number]): string =>
  c.data.partido ? nombreCorto(c.data.partido.id) : (c.data.otro_partido ?? '');
const resumenCorrupcion = resumirCorrupcion(casos, partidos);

/** Mismas tres secciones, en el mismo orden y con la misma introducción, para todos los gobiernos. */
const gruposDe = (g: (typeof gobiernos)[number]) => [
  {
    clave: 'contexto',
    titulo: 'El contexto: qué pasaba fuera de España',
    intro:
      'Guerras, crisis y decisiones exteriores que afectaron a España, y el ciclo económico y monetario mundial y europeo. Es el escenario en el que se gobernó: no atribuye ni resta mérito al Gobierno.',
    columnas: [
      { clave: 'internacional', titulo: 'Contexto internacional', hechos: g.data.contexto.internacional },
      { clave: 'economia-global', titulo: 'Economía global', hechos: g.data.contexto.economia_global },
    ],
  },
  {
    clave: 'economia',
    titulo: 'La economía: las cifras y cómo se vivió',
    intro:
      'Los agregados macroeconómicos y la experiencia de los hogares no tienen por qué coincidir: puede crecer el PIB y a la vez haber muchas familias con dificultades, o al revés. Se muestran por separado y sin atribuir causas: en estas cifras se mezclan el ciclo, el entorno exterior y las decisiones de cada época.',
    columnas: [
      { clave: 'macro', titulo: 'Macroeconomía', hechos: g.data.economia.macro },
      { clave: 'percepcion', titulo: 'Percepción y vida cotidiana', hechos: g.data.economia.percepcion },
    ],
  },
  {
    clave: 'balance',
    titulo: 'Qué se le reconoce y qué se le critica',
    intro: 'Hechos concretos del mandato, con las fuentes que los respaldan.',
    columnas: [
      { clave: 'logros', titulo: 'Logros', hechos: g.data.logros },
      { clave: 'criticas', titulo: 'Críticas', hechos: g.data.criticas },
    ],
  },
];

const ultima = fecha(
  new Date(Math.max(...[...gobiernos, ...casos, ...recuentos].map((e) => e.data.revisado.getTime()))),
  true,
);
---

<Base
  titulo="Repaso histórico · Elecciones 29-N-2026"
  descripcion="Los gobiernos de España desde 2000: contexto internacional y económico, macroeconomía frente a percepción ciudadana, logros y críticas con fuentes, y corrupción según sentencias firmes."
>
  <div class="contenedor">
    <div class="prosa intro">
      <h1>25 años de gobiernos, con fuentes</h1>
      <p class="entradilla">
        Quién gobernó desde 2000, qué se le reconoce y qué se le critica, y qué dicen los tribunales sobre corrupción.
      </p>
      <p>
        Cada gobierno sigue la misma estructura: el <strong>contexto</strong> en el que gobernó (qué pasaba en el mundo y
        en la economía global), <strong>la economía</strong> (las cifras agregadas y, aparte, cómo la vivió la
        ciudadanía) y, por último, sus <strong>logros</strong> y <strong>críticas</strong>. Cada punto es un hecho
        comprobable y lleva sus fuentes (datos oficiales, encuestas del CIS, normas, estudios, prensa), con el tipo de
        fuente a la vista. Lo que se publica de cada medio no es una valoración de esta web.
      </p>
      <p>
        Las cifras macro y la percepción se separan a propósito: una economía puede crecer y crear empleo mientras
        muchos hogares notan que no llegan a fin de mes, y a la inversa. Esta web no decide cuál de las dos lecturas
        pesa más ni atribuye al Gobierno de turno lo que ocurre en el mundo. Las encuestas del CIS cambiaron de
        formulación con el tiempo (desde 2022 no se ofrece «regular» como respuesta), así que sus porcentajes de épocas
        distintas no son directamente comparables.
      </p>
      <p>
        Es una primera pasada: hay periodos con menos puntos documentados que otros, y eso no significa nada sobre su
        balance. Se amplía a medida que se verifican más fuentes. Última revisión: <time datetime={ultima.iso}>{ultima.texto}</time>.
      </p>
    </div>

    <section aria-labelledby="titulo-linea" class="seccion">
      <h2 id="titulo-linea" class="sr-only">Línea de tiempo</h2>
      <LineaTiempo gobiernos={gobiernos} partidos={partidos} />
      <p class="ayuda">
        El color indica el bloque del partido que gobernó; el rayado, además, distingue la derecha. Pulsa un tramo para ir a
        ese gobierno.
      </p>
      <ul class="saltos">
        {
          gobiernos.map((g) => (
            <li>
              <a href={`#${g.id}`}>
                {g.data.presidente} <span class="ambito">({nombreCorto(g.data.partido.id)}, {periodo(g)})</span>
              </a>
            </li>
          ))
        }
        <li><a href="#corrupcion">Corrupción desde 2000</a></li>
      </ul>
    </section>

    {
      gobiernos.map((g) => (
        <section class="gobierno" id={g.id} aria-labelledby={`${g.id}-titulo`}>
          <header>
            <h2 id={`${g.id}-titulo`}>
              {g.data.presidente}
              <span class={`etiqueta etiqueta--${g.data.bloque}`}>
                {nombreCorto(g.data.partido.id)} · {BLOQUE_VISTA[g.data.bloque].etiqueta}
              </span>
            </h2>
            <p class="ambito">{periodo(g)}</p>
          </header>
          <p class="resumen">{g.data.resumen}</p>
          <details class="destacados">
            <summary>Cargos destacados del Gobierno</summary>
            <ul>
              {g.data.destacados.map((d) => (
                <li>
                  <strong>{d.nombre}</strong>: {d.cargo}
                </li>
              ))}
            </ul>
          </details>
          {g.data.nota_revision && <p class="aviso">{g.data.nota_revision}</p>}

          {gruposDe(g).map((grupo) => (
            <section class="grupo" aria-labelledby={`${g.id}-${grupo.clave}`}>
              <h3 class="grupo-titulo" id={`${g.id}-${grupo.clave}`}>{grupo.titulo}</h3>
              <p class="grupo-intro">{grupo.intro}</p>
              <div class="columnas">
                {grupo.columnas.map((col) => (
                  <section aria-labelledby={`${g.id}-${col.clave}`}>
                    <h4 class="col-titulo" id={`${g.id}-${col.clave}`}>{col.titulo}</h4>
                    {col.hechos.length === 0 ? (
                      <p class="vacio">Pendiente de documentar con fuentes.</p>
                    ) : (
                      <ul class="hechos">
                        {col.hechos.map((h) => (
                          <li>
                            <article>
                              <h5>{h.titulo}</h5>
                              <p>{h.descripcion}</p>
                              <p class="fuentes-titulo">Fuentes</p>
                              <ul class="fuentes-hecho">
                                {h.fuentes.map((f) => (
                                  <li>
                                    <a href={f.url} rel="noopener">
                                      {f.titulo}
                                    </a>{' '}
                                    <span class="ambito">
                                      · {f.medio} · {TIPO_FUENTE_HISTORIA[f.tipo]}
                                      {f.fecha && <> · <time datetime={fecha(f.fecha).iso}>{fecha(f.fecha).texto}</time></>}
                                    </span>
                                  </li>
                                ))}
                              </ul>
                            </article>
                          </li>
                        ))}
                      </ul>
                    )}
                  </section>
                ))}
              </div>
            </section>
          ))}
        </section>
      ))
    }

    <section class="gobierno" id="corrupcion" aria-labelledby="corrupcion-titulo">
      <header>
        <h2 id="corrupcion-titulo">Corrupción desde 2000</h2>
      </header>
      <div class="prosa">
        <p>
          Aquí solo entran <strong>sentencias firmes</strong>. Un caso en investigación o pendiente de juicio no es un
          hecho probado y no se presenta como tal. Los casos se ordenan por fecha de la sentencia, no por partido.
        </p>
        <p>
          No existe un registro oficial que asigne cada causa o condena a un partido. Por eso la sección tiene dos
          partes: los <strong>recuentos de terceros</strong>, con su metodología y sus límites, y una lista de
          <strong>casos con sentencia firme</strong> verificados uno a uno. La lista no es exhaustiva y no sirve para
          comparar partidos; para eso están los recuentos.
        </p>
      </div>

      <h3 id="graficas">Casos con sentencia firme en los últimos 20 años</h3>
      <div class="prosa">
        <p>
          Las gráficas cuentan los casos de la lista de abajo, agrupados por la legislatura en la que la sentencia
          quedó firme (no por la fecha de los hechos, que suelen abarcar varios años). Cada caso se asigna al partido
          con el que lo vinculan las fuentes; los que no son de ninguno de los seis partidos de esta web se agrupan en
          «Otros partidos». Como la lista no es exhaustiva, las cifras describen lo verificado hasta ahora, no el
          total de la corrupción de cada partido.
        </p>
      </div>
      <GraficoCorrupcion resumen={resumenCorrupcion} etiquetaPartido={etiquetaPartido} />

      <div class="prosa">
        <h4 id="por-que-pocas">¿Por qué parecen pocos casos y cifras bajas?</h4>
        <ul>
          <li>
            <strong>La lista es una muestra, no el total.</strong> Verificat cuenta 178 casos con condena firme desde
            1978 (más abajo); aquí hay una parte, verificada uno a uno. Las gráficas no miden cuánta corrupción hay.
          </li>
          <li>
            <strong>Los tribunales solo cifran lo que prueban.</strong> Una sentencia fija el dinero malversado, la
            cuota defraudada o la comisión demostrada en esa causa, que suele ser menos que lo investigado o lo que
            cuenta la prensa. Cuando las fuentes no coinciden, esta web no pone cifra.
          </li>
          <li>
            <strong>Delitos distintos, cifras distintas.</strong> Cobrar comisiones, pagar en negro, desviar dinero
            público o financiar un partido de forma irregular son delitos diferentes (cohecho, delito fiscal,
            malversación…) y cada sentencia mide algo propio. Por eso los importes no se suman.
          </li>
          <li>
            <strong>Pocos procesos acaban en condena firme y tardan años.</strong> El CGPJ contó 200 personas
            procesadas por corrupción en 2022 y 146 en 2024, con 61 y 51 sentencias al año; el 59-74 % fueron
            condenatorias, y una parte por conformidad. Una causa grande puede tardar más de una década.
          </li>
          <li>
            <strong>Una sentencia puede deshacerse.</strong> Los ERE de Andalucía y la «caja B» de la Gürtel muestran
            que recursos posteriores recortan penas o anulan condenas.
          </li>
        </ul>
      </div>

      <h3 id="recuentos">Recuentos de terceros</h3>
      <ul class="recuentos">
        {
          recuentos.map((r) => (
            <li>
              <article aria-labelledby={`recuento-${r.id}`}>
                <h4 id={`recuento-${r.id}`}>
                  <a href={r.data.url} rel="noopener">{r.data.titulo}</a>
                </h4>
                <p class="ambito">
                  {r.data.autoria} · <time datetime={fecha(r.data.publicado).iso}>{fecha(r.data.publicado).texto}</time>
                </p>
                <p><strong>Alcance:</strong> {r.data.alcance}</p>
                <p><strong>Método:</strong> {r.data.metodologia}</p>
                <table>
                  <caption class="sr-only">Cifras del recuento</caption>
                  <thead>
                    <tr><th scope="col">Medida</th><th scope="col">Partido</th><th scope="col">Cifra</th></tr>
                  </thead>
                  <tbody>
                    {r.data.cifras.map((c) => (
                      <tr>
                        <td>{c.concepto}</td>
                        <td>{c.partido ?? 'Total'}</td>
                        <td>{c.valor}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <p class="fuentes-titulo">Límites de esta cifra</p>
                <ul class="limites">
                  {r.data.limitaciones.map((l) => <li>{l}</li>)}
                </ul>
              </article>
            </li>
          ))
        }
      </ul>
      <p class="aviso">
        Los recuentos miden cosas distintas (procedimientos, casos e importes, o sentencias del año) y cubren periodos
        distintos: no se suman ni se comparan entre sí.
      </p>

      <h3 id="casos">Casos con sentencia firme</h3>
      <ul class="casos">
        {
          casos.map((c) => (
            <li>
              <article aria-labelledby={`caso-${c.id}`}>
                <h4 id={`caso-${c.id}`}>
                  {c.data.nombre} <span class="etiqueta etiqueta--neutra">{etiquetaPartido(c)}</span>
                </h4>
                <p class="ambito">
                  {c.data.territorio} · {c.data.firme.tribunal}, sentencia del{' '}
                  <time datetime={fecha(c.data.firme.fecha).iso}>{fecha(c.data.firme.fecha, true).texto}</time>
                </p>
                <p>{c.data.resumen}</p>
                <table>
                  <caption class="sr-only">Condenas del caso {c.data.nombre}</caption>
                  <thead>
                    <tr><th scope="col">Persona</th><th scope="col">Cargo</th><th scope="col">Pena</th></tr>
                  </thead>
                  <tbody>
                    {c.data.condenas.map((p) => (
                      <tr><td>{p.persona}</td><td>{p.cargo}</td><td>{p.pena}</td></tr>
                    ))}
                  </tbody>
                </table>
                {c.data.responsabilidad_partido && (
                  <p><strong>Responsabilidad del partido:</strong> {c.data.responsabilidad_partido}</p>
                )}
                {c.data.cuantia && (
                  <p>
                    <strong>Importe:</strong> {new Intl.NumberFormat('es-ES').format(c.data.cuantia.euros)} € ·{' '}
                    {c.data.cuantia.concepto}
                  </p>
                )}
                {c.data.nota && <p class="aviso">{c.data.nota}</p>}
                <p class="fuentes-titulo">Fuentes</p>
                <ul class="fuentes-hecho">
                  {c.data.fuentes.map((f) => (
                    <li>
                      <a href={f.url} rel="noopener">{f.titulo}</a>{' '}
                      <span class="ambito">· {f.medio} · {TIPO_FUENTE_HISTORIA[f.tipo]}</span>
                    </li>
                  ))}
                </ul>
              </article>
            </li>
          ))
        }
      </ul>

      <div class="prosa pendiente">
        <h3>Qué falta</h3>
        <ul>
          <li>Más casos con sentencia firme desde 2000, para todos los partidos, con un criterio de inclusión fijo.</li>
          <li>Un recuento fiable del número de personas condenadas por partido: hoy no hay cifra verificada.</li>
          <li>El importe fijado por los tribunales en los casos que hoy no tienen cifra verificada (Gürtel, ERE, Koldo, Marea…).</li>
          <li>
            Una estimación fiable del coste total de la corrupción. Se citan cifras de decenas de miles de millones de
            euros (por ejemplo, la que se atribuye a la CNMC mide sobrecostes por falta de competencia en la
            contratación, no corrupción), pero aún no se ha podido leer el estudio original; hasta entonces no se
            publica ninguna.
          </li>
          <li>Un recuento de personas imputadas por partido: imputado no es culpable y ninguna fuente oficial lo publica.</li>
          <li>Casos firmes que aún no están en la lista, como Malaya (Marbella) o Nóos, pendientes de verificar.</li>
        </ul>
      </div>
    </section>
  </div>
</Base>

<style>
  .intro {
    margin-bottom: var(--space-6);
  }

  .seccion {
    margin-bottom: var(--space-7);
  }

  .ayuda {
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .saltos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    margin-top: var(--space-3);
    list-style: none;
  }

  .gobierno {
    padding-block: var(--space-6);
    border-top: 1px solid var(--border-strong);
    scroll-margin-top: var(--space-4);
  }

  .gobierno > header {
    margin-bottom: var(--space-3);
  }

  h2 {
    font-size: var(--step-2);
  }

  h3 {
    font-size: var(--step-1);
    margin-bottom: var(--space-3);
  }

  h4 {
    font-size: 1.0625rem;
    font-family: var(--font-display);
    line-height: 1.3;
  }

  .etiqueta {
    display: inline-block;
    margin-left: var(--space-2);
    padding: 0 var(--space-2);
    border-radius: var(--radius);
    color: var(--sobre-bloque);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.7;
    vertical-align: 0.25em;
  }

  .etiqueta--derecha {
    background-color: var(--bloque-derecha);
    background-image: repeating-linear-gradient(45deg, rgb(255 255 255 / 0.2) 0 5px, transparent 5px 10px);
  }

  .etiqueta--izquierda {
    background-color: var(--bloque-izquierda);
  }

  /* La etiqueta del caso no se colorea: el color de partido solo aparece en las gráficas, junto al nombre y la cifra. */
  .etiqueta--neutra {
    border: 1px solid var(--border-strong);
    color: var(--text);
  }

  .resumen {
    max-width: var(--measure);
  }

  .destacados {
    max-width: var(--measure);
    margin-top: var(--space-3);
  }

  .destacados summary {
    cursor: pointer;
    color: var(--link);
  }

  .destacados ul {
    padding-left: 1.1em;
    margin-top: var(--space-2);
  }

  .aviso {
    max-width: var(--measure);
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-left: 3px solid var(--parcial);
    color: var(--parcial);
    font-size: var(--step--1);
  }

  .grupo {
    margin-top: var(--space-6);
  }

  .grupo-titulo {
    font-size: var(--step-1);
    margin-bottom: var(--space-2);
  }

  .grupo-intro {
    max-width: var(--measure);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .col-titulo {
    margin-bottom: var(--space-3);
    font-size: var(--step-0);
  }

  .hechos h5 {
    font-size: 1.0625rem;
    font-family: var(--font-display);
    line-height: 1.3;
  }

  .columnas {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-4);
  }

  @media (min-width: 64rem) {
    .columnas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .hechos,
  .recuentos,
  .casos {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .hechos article,
  .recuentos article,
  .casos article {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .fuentes-titulo {
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .fuentes-hecho,
  .limites {
    padding-left: 1.1em;
    font-size: 0.9375rem;
  }

  .fuentes-hecho li + li,
  .limites li + li {
    margin-top: var(--space-1);
  }

  .vacio {
    color: var(--pendiente);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th,
  td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }

  th {
    background: var(--head);
    font-weight: 600;
  }

  #corrupcion h3 {
    margin-top: var(--space-6);
  }

  .pendiente ul {
    padding-left: 1.1em;
  }

  @media (max-width: 40rem) {
    .hechos article,
    .recuentos article,
    .casos article {
      padding: var(--space-3);
    }

    table {
      display: block;
      overflow-x: auto;
    }
  }
</style>
