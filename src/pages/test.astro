---
import Base from '../layouts/Base.astro';
import AvisoConvocatoria from '../components/AvisoConvocatoria.astro';
import { cargarDatos, localizador, urlPropuesta } from '../lib/ui';
import { IMPORTANCIAS, IMPORTANCIA_INICIAL, cargarPreguntas, type DatosCliente } from '../lib/test';
import { NOMBRE_MAX } from '../lib/test-estado';

const datos = await cargarDatos();
const { temas, fuente } = datos;
// El test no tiene preguntas de ejemplo: los partidos ficticios no aparecen.
const partidos = datos.partidos.filter((p) => !p.data.ficticio);
const preguntas = await cargarPreguntas(temas);
const nombre = new Map(partidos.map((p) => [p.id, p.data.nombre_corto]));
const nombreTema = new Map(temas.map((t) => [t.id, t.data.nombre]));
const temasTest = temas.filter((t) => preguntas.some((p) => p.data.tema.id === t.id));

const cliente: DatosCliente = {
  partidos: partidos.map((p) => p.id),
  preguntas: preguntas.map((p) => ({
    id: p.id,
    tema: p.data.tema.id,
    opciones: p.data.opciones.map((o) => o.partidos.map((x) => x.partido.id)),
  })),
};
const letra = (i: number): string => String.fromCharCode(97 + i);
---

<Base
  titulo="Test de afinidad · Elecciones 29-N-2026"
  descripcion="Test de afinidad con las propuestas de los partidos para las elecciones generales del 29 de noviembre de 2026: elige la respuesta que más se acerca a lo que piensas y cuánto te importa cada pregunta."
>
  <div class="contenedor">
    <div class="prosa compartido" id="compartido" hidden>
      <p class="entradilla">Estás viendo el resultado que ha compartido <strong id="compartido-nombre"></strong>.</p>
      <p class="ayuda">
        El nombre lo escribe quien comparte el enlace; esta web no lo comprueba. Las respuestas viajan en el propio
        enlace y no se guardan en ningún servidor. El porcentaje se calcula con las propuestas publicadas hoy, que pueden
        haber cambiado desde que se compartió.
      </p>
      <p class="ayuda" id="compartido-descartadas" hidden></p>
      <div class="acciones">
        <a class="boton principal" href="/test">Haz tú el test</a>
      </div>
    </div>

    <div class="prosa intro">
      <h1>Test de afinidad</h1>
      <p class="entradilla">
        {preguntas.length} preguntas sobre los {temasTest.length} temas de la web. Cada respuesta resume lo que propone al
        menos un partido, sin decir cuál.
      </p>
      <p>
        Elige la respuesta que más se acerque a lo que piensas e indica cuánto te importa la pregunta, de 5 (muy
        importante) a 0 (no te importa). Las preguntas con importancia 0 no cuentan y no hace falta responderlas. Al
        final verás qué porcentaje de tus respuestas coincide con las propuestas de cada partido, ponderado por la
        importancia que les has dado, y qué partido propone cada respuesta, con enlace a su fuente.
      </p>
      <p class="aviso">
        Es una medida de coincidencia con las propuestas publicadas, no una recomendación de voto. Varios partidos aún no
        han publicado propuestas sobre muchos temas: su porcentaje se calcula solo con las preguntas en las que tienen
        alguna, y se indica sobre cuántas.
      </p>
    </div>

    <form id="test" class="test" novalidate>
      <div class="errores" id="errores" tabindex="-1" hidden>
        <h2>Faltan respuestas</h2>
        <p>Responde estas preguntas o ponles importancia 0:</p>
        <ul></ul>
      </div>

      <ol class="preguntas">
        {
          preguntas.map((p, i) => (
            <li class="pregunta" id={`p-${p.id}`} data-id={p.id}>
              <p class="tema">{nombreTema.get(p.data.tema.id)}</p>
              <h2 id={`t-${p.id}`}>
                <span class="numero">{i + 1}.</span> {p.data.pregunta}
              </h2>
              <fieldset class="opciones" aria-labelledby={`t-${p.id}`} aria-describedby={`nota-${p.id}`}>
                <ul>
                  {p.data.opciones.map((o, j) => (
                    <li>
                      <label>
                        <input type="radio" name={`r-${p.id}`} value={j} />
                        <span>{o.texto}</span>
                      </label>
                    </li>
                  ))}
                </ul>
              </fieldset>
              <p class="nota" id={`nota-${p.id}`} aria-live="polite" />
              <fieldset class="importancia">
                <legend>
                  ¿Cuánto te importa?<span class="sr-only"> Pregunta {i + 1}.</span>
                </legend>
                <div class="escala">
                  {IMPORTANCIAS.map((n) => (
                    <label>
                      <input
                        type="radio"
                        name={`i-${p.id}`}
                        value={n}
                        checked={n === IMPORTANCIA_INICIAL}
                        aria-label={n === 0 ? '0, no me importa' : n === 5 ? '5, muy importante' : String(n)}
                      />
                      <span aria-hidden="true">{n}</span>
                    </label>
                  ))}
                  <span class="extremos" aria-hidden="true">
                    <span>Nada</span>
                    <span>Mucho</span>
                  </span>
                </div>
              </fieldset>
            </li>
          ))
        }
      </ol>

      <div class="barra-test">
        <p class="estado" aria-live="polite">
          <span id="progreso"></span>
          <span class="guardado">Se guarda automáticamente en este navegador.</span>
        </p>
        <button type="button" id="reiniciar">Reiniciar</button>
      </div>

      <div class="acciones">
        <button type="submit" class="principal">Ver mi resultado</button>
      </div>
    </form>

    <section id="resultado" class="resultado" aria-labelledby="resultado-titulo" tabindex="-1" hidden>
      <h2 id="resultado-titulo">Tu resultado</h2>
      <p class="prosa ayuda" id="resumen"></p>
      <p class="prosa ayuda">
        Porcentaje del peso de las respuestas que coincide con las propuestas de cada partido, contando solo las preguntas
        en las que ese partido tiene alguna propuesta. Los partidos aparecen en el orden fijo de la web, no ordenados por
        el resultado.
      </p>

      <ul class="afinidad">
        {
          partidos.map((p) => (
            <li data-partido={p.id}>
              <div class="afinidad__cabecera">
                <strong>{p.data.nombre_corto}</strong>
                <span class="ambito">{p.data.ambito.etiqueta}</span>
              </div>
              <div class="afinidad__fila">
                <span class="barra" aria-hidden="true">
                  <span />
                </span>
                <span class="pct" />
              </div>
              <p class="cobertura" />
            </li>
          ))
        }
      </ul>

      <details class="detalle">
        <summary>Afinidad por tema</summary>
        <div class="tabla">
          <table>
            <caption class="sr-only">Porcentaje de coincidencia por tema y partido</caption>
            <thead>
              <tr>
                <th scope="col">Tema</th>
                {partidos.map((p) => <th scope="col">{p.data.nombre_corto}</th>)}
              </tr>
            </thead>
            <tbody>
              {
                temasTest.map((t) => (
                  <tr data-tema={t.id}>
                    <th scope="row">{t.data.nombre}</th>
                    {partidos.map((p) => (
                      <td data-partido={p.id} />
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="ayuda">«—»: no cuenta ninguna pregunta del tema con propuesta de ese partido.</p>
      </details>

      <details class="detalle">
        <summary>Qué partido propone cada respuesta</summary>
        <ol class="claves">
          {
            preguntas.map((p, i) => (
              <li data-id={p.id}>
                <p class="clave__pregunta">
                  {i + 1}. {p.data.pregunta} <span class="clave__importancia" />
                </p>
                <ul>
                  {p.data.opciones.map((o, j) => (
                    <li data-opcion={j}>
                      <p>
                        <span class="sr-only">Respuesta {letra(j)}: </span>
                        {o.texto} <strong class="tuya" hidden />
                      </p>
                      <ul class="fuentes">
                        {o.partidos.map(({ partido, fuente: idFuente, pagina }) => {
                          const f = fuente(idFuente.id);
                          return (
                            <li>
                              <span class="clave__partido">{nombre.get(partido.id) ?? partido.id}:</span>{' '}
                              <a href={urlPropuesta(f, pagina)} rel="noopener">
                                {f.data.titulo}, {localizador(pagina)}
                              </a>
                              <AvisoConvocatoria fuente={f} />
                            </li>
                          );
                        })}
                      </ul>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </details>

      <div class="acciones" id="acciones-propias">
        <button type="button" id="volver">Cambiar respuestas</button>
      </div>

      <section class="compartir" id="compartir" aria-labelledby="compartir-titulo">
        <h3 id="compartir-titulo">Compartir el resultado</h3>
        <p class="ayuda">
          Se crea un enlace con tus respuestas dentro. No se guarda en ningún servidor: quien tenga el enlace verá este
          resultado.
        </p>
        <form id="compartir-form" class="compartir__fila">
          <label for="compartir-nombre">Tu nombre o pseudónimo</label>
          <input id="compartir-nombre" type="text" maxlength={NOMBRE_MAX} autocomplete="nickname" required />
          <button type="submit" class="principal">Crear enlace</button>
        </form>
        <div class="compartir__fila" id="compartir-enlace" hidden>
          <label for="compartir-url">Enlace</label>
          <input id="compartir-url" type="url" readonly />
          <button type="button" id="copiar">Copiar</button>
          <p class="ayuda" id="copiado" aria-live="polite"></p>
        </div>
      </section>
    </section>
  </div>
</Base>

<script is:inline type="application/json" id="datos-test" set:html={JSON.stringify(cliente)} />

<script>
  import type { DatosCliente } from '../lib/test';
  import {
    CLAVE_ESTADO,
    PREFIJO_COMPARTIR,
    codificar,
    decodificar,
    progreso,
    type Estado,
  } from '../lib/test-estado';

  const datos = JSON.parse(document.getElementById('datos-test')?.textContent ?? '{}') as DatosCliente;
  const form = document.querySelector<HTMLFormElement>('#test');
  const errores = document.querySelector<HTMLElement>('#errores');
  const resultado = document.querySelector<HTMLElement>('#resultado');
  if (!form || !errores || !resultado) throw new Error('Faltan elementos del test');

  const bloque = (id: string): HTMLElement | null => form.querySelector(`.pregunta[data-id="${CSS.escape(id)}"]`);

  const leer = (): Estado =>
    Object.fromEntries(
      datos.preguntas.map(({ id }) => {
        const valor = (nombre: string) =>
          form.querySelector<HTMLInputElement>(`input[name="${CSS.escape(nombre)}"]:checked`)?.value;
        const r = valor(`r-${id}`);
        return [id, { importancia: Number(valor(`i-${id}`) ?? 0), respuesta: r === undefined ? null : Number(r) }];
      }),
    );

  // — Importancia 0: las respuestas se desactivan y no cuentan (se conserva la elección) —

  const actualizar = (id: string): void => {
    const el = bloque(id);
    const opciones = el?.querySelector<HTMLFieldSetElement>('.opciones');
    const nota = el?.querySelector<HTMLElement>('.nota');
    if (!el || !opciones || !nota) return;
    const cero = leer()[id]?.importancia === 0;
    opciones.disabled = cero;
    el.classList.toggle('pregunta--cero', cero);
    nota.textContent = cero ? 'Importancia 0: esta pregunta no cuenta en el resultado.' : '';
    if (cero) el.classList.remove('pregunta--falta');
  };

  // — Guardar en este navegador (opcional; si falla, el test funciona igual) —

  const guardar = (): void => {
    try {
      localStorage.setItem(CLAVE_ESTADO, JSON.stringify(leer()));
    } catch {
      /* almacenamiento no disponible */
    }
  };

  const restaurar = (): void => {
    let guardado: Estado = {};
    try {
      guardado = JSON.parse(localStorage.getItem(CLAVE_ESTADO) ?? '{}') as Estado;
    } catch {
      return;
    }
    for (const { id } of datos.preguntas) {
      const g = guardado[id];
      if (!g) continue;
      const marcar = (nombre: string, valor: number) => {
        const input = form.querySelector<HTMLInputElement>(`input[name="${CSS.escape(nombre)}"][value="${valor}"]`);
        if (input) input.checked = true;
      };
      marcar(`i-${id}`, g.importancia);
      if (g.respuesta !== null) marcar(`r-${id}`, g.respuesta);
    }
  };

  const textoProgreso = document.querySelector<HTMLElement>('#progreso');
  const pintarProgreso = (): void => {
    const { respondidas, total } = progreso(leer());
    if (textoProgreso) textoProgreso.textContent = `${respondidas} de ${total} respondidas.`;
  };

  restaurar();
  datos.preguntas.forEach(({ id }) => actualizar(id));
  pintarProgreso();

  form.addEventListener('change', (e) => {
    const id = e.target instanceof HTMLInputElement ? e.target.closest<HTMLElement>('.pregunta')?.dataset.id : undefined;
    if (id) {
      actualizar(id);
      if (leer()[id]?.respuesta !== null) bloque(id)?.classList.remove('pregunta--falta');
    }
    guardar();
    pintarProgreso();
  });

  document.querySelector('#reiniciar')?.addEventListener('click', () => {
    if (!confirm('¿Borrar todas tus respuestas y empezar de nuevo?')) return;
    form.reset();
    pintarProgreso();
    try {
      localStorage.removeItem(CLAVE_ESTADO);
    } catch {
      /* almacenamiento no disponible */
    }
    datos.preguntas.forEach(({ id }) => {
      actualizar(id);
      bloque(id)?.classList.remove('pregunta--falta');
    });
    errores.hidden = true;
    resultado.hidden = true;
  });

  document.querySelector('#volver')?.addEventListener('click', () => {
    form.scrollIntoView();
    form.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
  });

  // — Cálculo —

  interface Suma {
    acierto: number;
    peso: number;
    preguntas: number;
  }

  const vacia = (): Suma => ({ acierto: 0, peso: 0, preguntas: 0 });
  const pct = (s: Suma): number | null => (s.peso > 0 ? Math.round((100 * s.acierto) / s.peso) : null);

  const calcular = (estado: Estado) => {
    const global = new Map(datos.partidos.map((p) => [p, vacia()]));
    const porTema = new Map<string, Map<string, Suma>>();
    let pesoTotal = 0;
    let cuentan = 0;
    for (const q of datos.preguntas) {
      const { importancia, respuesta } = estado[q.id] ?? { importancia: 0, respuesta: null };
      if (importancia === 0 || respuesta === null) continue;
      pesoTotal += importancia;
      cuentan += 1;
      const elegida = new Set(q.opciones[respuesta] ?? []);
      const tema = porTema.get(q.tema) ?? new Map(datos.partidos.map((p) => [p, vacia()]));
      porTema.set(q.tema, tema);
      for (const partido of q.opciones.flat()) {
        for (const s of [global.get(partido), tema.get(partido)]) {
          if (!s) continue;
          s.peso += importancia;
          s.preguntas += 1;
          if (elegida.has(partido)) s.acierto += importancia;
        }
      }
    }
    return { global, porTema, pesoTotal, cuentan };
  };

  /** `nombre` solo en un resultado compartido. */
  const mostrar = (estado: Estado, nombre?: string): void => {
    const ajeno = nombre !== undefined;
    const titulo = resultado.querySelector<HTMLElement>('#resultado-titulo');
    if (titulo) titulo.textContent = ajeno ? `Resultado de ${nombre}` : 'Tu resultado';
    for (const id of ['#acciones-propias', '#compartir'])
      resultado.querySelector<HTMLElement>(id)?.toggleAttribute('hidden', ajeno);
    const { global, porTema, pesoTotal, cuentan } = calcular(estado);
    const resumen = resultado.querySelector<HTMLElement>('#resumen');
    if (resumen)
      resumen.textContent =
        cuentan === 0
          ? 'Todas las preguntas tienen importancia 0: no hay nada que calcular.'
          : `Cuentan ${cuentan} de ${datos.preguntas.length} preguntas.`;

    for (const partido of datos.partidos) {
      const li = resultado.querySelector<HTMLElement>(`.afinidad [data-partido="${CSS.escape(partido)}"]`);
      const s = global.get(partido);
      if (!li || !s) continue;
      const valor = pct(s);
      const barra = li.querySelector<HTMLElement>('.barra > span');
      const texto = li.querySelector<HTMLElement>('.pct');
      const cobertura = li.querySelector<HTMLElement>('.cobertura');
      if (barra) barra.style.width = `${valor ?? 0}%`;
      li.classList.toggle('afinidad--sin', valor === null);
      if (texto) texto.textContent = valor === null ? 'Sin datos' : `${valor} %`;
      if (cobertura) {
        const parte = pesoTotal > 0 ? s.peso / pesoTotal : 0;
        cobertura.textContent =
          valor === null
            ? 'No tiene propuestas publicadas sobre las preguntas que cuentan.'
            : `Calculado sobre ${s.preguntas} de ${cuentan} preguntas (${Math.round(100 * parte)} % del peso).` +
              (parte < 0.5 ? ' Con tan pocas preguntas, el porcentaje es poco representativo.' : '');
      }
    }

    for (const fila of resultado.querySelectorAll<HTMLTableRowElement>('tbody tr')) {
      const tema = porTema.get(fila.dataset.tema ?? '');
      for (const celda of fila.querySelectorAll<HTMLTableCellElement>('td')) {
        const s = tema?.get(celda.dataset.partido ?? '');
        const valor = s ? pct(s) : null;
        celda.textContent = valor === null ? '—' : `${valor} %`;
      }
    }

    for (const q of datos.preguntas) {
      const li = resultado.querySelector<HTMLElement>(`.claves > li[data-id="${CSS.escape(q.id)}"]`);
      if (!li) continue;
      const { importancia, respuesta } = estado[q.id] ?? { importancia: 0, respuesta: null };
      const cuenta = importancia > 0 && respuesta !== null;
      const etiqueta = li.querySelector<HTMLElement>('.clave__importancia');
      if (etiqueta) etiqueta.textContent = cuenta ? `(importancia ${importancia})` : '(no cuenta)';
      for (const op of li.querySelectorAll<HTMLElement>('[data-opcion]')) {
        const tuya = cuenta && Number(op.dataset.opcion) === respuesta;
        op.classList.toggle('elegida', tuya);
        const marca = op.querySelector<HTMLElement>('.tuya');
        if (marca) {
          marca.hidden = !tuya;
          marca.textContent = ajeno ? '(respuesta elegida)' : '(tu respuesta)';
        }
      }
    }

    resultado.hidden = false;
    if (ajeno) return;
    resultado.scrollIntoView();
    resultado.focus({ preventScroll: true });
  };

  // — Compartir: las respuestas van en el fragmento de la URL, que no llega al servidor —

  const formCompartir = document.querySelector<HTMLFormElement>('#compartir-form');
  const campoNombre = document.querySelector<HTMLInputElement>('#compartir-nombre');
  const bloqueEnlace = document.querySelector<HTMLElement>('#compartir-enlace');
  const campoUrl = document.querySelector<HTMLInputElement>('#compartir-url');
  const copiado = document.querySelector<HTMLElement>('#copiado');

  formCompartir?.addEventListener('submit', (e) => {
    e.preventDefault();
    const nombre = campoNombre?.value.trim() ?? '';
    if (!nombre || !campoUrl || !bloqueEnlace) return;
    campoUrl.value = `${location.origin}${location.pathname}${PREFIJO_COMPARTIR}${codificar(nombre, leer())}`;
    bloqueEnlace.hidden = false;
    if (copiado) copiado.textContent = '';
    campoUrl.select();
  });

  // Si se cambia el nombre, el enlace anterior ya no corresponde.
  campoNombre?.addEventListener('input', () => {
    if (bloqueEnlace) bloqueEnlace.hidden = true;
  });

  document.querySelector('#copiar')?.addEventListener('click', async () => {
    if (!campoUrl || !copiado) return;
    try {
      await navigator.clipboard.writeText(campoUrl.value);
      copiado.textContent = 'Enlace copiado.';
    } catch {
      campoUrl.select();
      copiado.textContent = 'Selecciona el enlace y cópialo.';
    }
  });

  // — Resultado compartido (`/test#r=…`): solo lectura, no toca las respuestas guardadas —

  const verCompartido = (): boolean => {
    if (!location.hash.startsWith(PREFIJO_COMPARTIR)) return false;
    const compartido = decodificar(location.hash.slice(PREFIJO_COMPARTIR.length), datos.preguntas);
    const aviso = document.querySelector<HTMLElement>('#compartido');
    if (!compartido || !aviso) return false;
    const nombre = compartido.nombre || 'alguien';
    const destino = aviso.querySelector<HTMLElement>('#compartido-nombre');
    if (destino) destino.textContent = nombre;
    const descartadas = aviso.querySelector<HTMLElement>('#compartido-descartadas');
    if (descartadas && compartido.descartadas > 0) {
      descartadas.hidden = false;
      descartadas.textContent =
        compartido.descartadas === 1
          ? 'Una respuesta del enlace corresponde a una pregunta que ha cambiado o ya no está en el test y no cuenta.'
          : `${compartido.descartadas} respuestas del enlace corresponden a preguntas que han cambiado o ya no están en el test y no cuentan.`;
    }
    aviso.hidden = false;
    document.querySelector<HTMLElement>('.intro')?.setAttribute('hidden', '');
    form.hidden = true;
    mostrar(compartido.estado, nombre);
    return true;
  };

  verCompartido();
  // Un enlace compartido abierto con /test ya cargado solo cambia el fragmento.
  window.addEventListener('hashchange', () => {
    if (location.hash.startsWith(PREFIJO_COMPARTIR)) location.reload();
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const estado = leer();
    const faltan = datos.preguntas
      .map((q, i) => ({ ...q, n: i + 1 }))
      .filter((q) => (estado[q.id]?.importancia ?? 0) > 0 && estado[q.id]?.respuesta === null);
    for (const q of datos.preguntas)
      bloque(q.id)?.classList.toggle(
        'pregunta--falta',
        faltan.some((f) => f.id === q.id),
      );
    if (faltan.length > 0) {
      const lista = errores.querySelector('ul');
      if (lista)
        lista.replaceChildren(
          ...faltan.map((q) => {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = `#p-${q.id}`;
            a.textContent = `Pregunta ${q.n}: ${bloque(q.id)?.querySelector('h2')?.textContent?.replace(/^\s*\d+\.\s*/, '') ?? ''}`;
            li.append(a);
            return li;
          }),
        );
      resultado.hidden = true;
      errores.hidden = false;
      errores.scrollIntoView();
      errores.focus({ preventScroll: true });
      return;
    }
    errores.hidden = true;
    mostrar(estado);
  });
</script>

<style>
  .intro {
    margin-bottom: var(--space-6);
  }

