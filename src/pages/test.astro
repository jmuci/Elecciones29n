---
import Base from '../layouts/Base.astro';
import AvisoConvocatoria from '../components/AvisoConvocatoria.astro';
import { cargarDatos, localizador, urlPropuesta } from '../lib/ui';
import { IMPORTANCIAS, IMPORTANCIA_INICIAL, cargarPreguntas, type DatosCliente } from '../lib/test';
import { NOMBRE_MAX } from '../lib/test-estado';

const datos = await cargarDatos();
const { temas, fuente } = datos;
// El test no tiene preguntas de ejemplo: los partidos ficticios no aparecen.
const partidos = datos.partidos.filter((p) => !p.data.ficticio);
const preguntas = await cargarPreguntas(temas);
const nombre = new Map(partidos.map((p) => [p.id, p.data.nombre_corto]));
const temasTest = temas.filter((t) => preguntas.some((p) => p.data.tema.id === t.id));
// Una página por tema; el número de cada pregunta sigue siendo global.
const pasos = temasTest.map((t) => ({
  tema: t,
  preguntas: preguntas.flatMap((p, i) => (p.data.tema.id === t.id ? [{ p, n: i + 1 }] : [])),
}));

const cliente: DatosCliente = {
  partidos: partidos.map((p) => p.id),
  nombres: Object.fromEntries(partidos.map((p) => [p.id, p.data.nombre_corto])),
  temas: Object.fromEntries(temasTest.map((t) => [t.id, t.data.nombre])),
  preguntas: preguntas.map((p) => ({
    id: p.id,
    tema: p.data.tema.id,
    opciones: p.data.opciones.map((o) => o.partidos.map((x) => x.partido.id)),
  })),
};
const letra = (i: number): string => String.fromCharCode(97 + i);
---

<Base
  titulo="Test de afinidad · Elecciones 29-N-2026"
  descripcion="Test de afinidad con las propuestas de los partidos para las elecciones generales del 29 de noviembre de 2026: elige la respuesta que más se acerca a lo que piensas y cuánto te importa cada pregunta."
>
  <div class="contenedor">
    <div class="prosa compartido" id="compartido" hidden>
      <p class="entradilla">Estás viendo el resultado que ha compartido <strong id="compartido-nombre"></strong>.</p>
      <p class="ayuda">
        El nombre lo escribe quien comparte el enlace; esta web no lo comprueba. Las respuestas viajan en el propio
        enlace y no se guardan en ningún servidor. El porcentaje se calcula con las propuestas publicadas hoy, que pueden
        haber cambiado desde que se compartió.
      </p>
      <p class="ayuda" id="compartido-descartadas" hidden></p>
      <div class="acciones">
        <a class="boton principal" href="/test">Haz tú el test</a>
      </div>
    </div>

    <div class="prosa intro">
      <h1>Test de afinidad</h1>
      <p class="entradilla">
        {preguntas.length} preguntas sobre los {temasTest.length} temas de la web, un tema por página. Cada respuesta
        resume lo que propone al menos un partido, sin decir cuál.
      </p>
      <p>
        Elige la respuesta que más se acerque a lo que piensas e indica cuánto te importa la pregunta, de 1 (poco
        importante) a 5 (muy importante). Al final verás qué porcentaje de tus respuestas coincide con las propuestas
        de cada partido, ponderado por la importancia que les has dado, un mapa de cercanía con los partidos y qué
        partido propone cada respuesta, con enlace a su fuente.
      </p>
      <p class="aviso">
        Es una medida de coincidencia con las propuestas publicadas, no una recomendación de voto. Varios partidos aún no
        han publicado propuestas sobre muchos temas: su porcentaje se calcula solo con las preguntas en las que tienen
        alguna, y se indica sobre cuántas.
      </p>
    </div>

    <form id="test" class="test" novalidate>
      <div class="progreso">
        <p class="progreso__texto">
          <span id="paso-texto">Tema 1 de {pasos.length}</span>
          <span id="progreso"></span>
        </p>
        <div
          class="progreso__barra"
          id="progreso-barra"
          role="progressbar"
          aria-label="Preguntas respondidas"
          aria-valuemin="0"
          aria-valuemax={preguntas.length}
          aria-valuenow="0"
        >
          <span></span>
        </div>
      </div>

      {
        pasos.map(({ tema, preguntas: delTema }, k) => (
          <section class="paso" data-paso={k} aria-labelledby={`paso-${k}`} hidden={k > 0}>
            <h2 class="paso__tema" id={`paso-${k}`} tabindex="-1">
              {tema.data.nombre}
            </h2>
            <p class="falta" role="alert" hidden>
              Responde las preguntas marcadas para seguir.
            </p>
            <ol class="preguntas">
              {delTema.map(({ p, n }) => (
                <li class="pregunta" id={`p-${p.id}`} data-id={p.id}>
                  <h3 id={`t-${p.id}`}>
                    <span class="numero">{n}.</span> {p.data.pregunta}
                  </h3>
                  <fieldset class="opciones" aria-labelledby={`t-${p.id}`}>
                    <ul>
                      {p.data.opciones.map((o, j) => (
                        <li>
                          <label>
                            <input type="radio" name={`r-${p.id}`} value={j} />
                            <span>{o.texto}</span>
                          </label>
                        </li>
                      ))}
                    </ul>
                  </fieldset>
                  <fieldset class="importancia">
                    <legend>
                      ¿Cuánto te importa?<span class="sr-only"> Pregunta {n}.</span>
                    </legend>
                    <div class="escala">
                      {IMPORTANCIAS.map((v) => (
                        <label>
                          <input
                            type="radio"
                            name={`i-${p.id}`}
                            value={v}
                            checked={v === IMPORTANCIA_INICIAL}
                            aria-label={v === 1 ? '1, poco importante' : v === 5 ? '5, muy importante' : String(v)}
                          />
                          <span aria-hidden="true">{v}</span>
                        </label>
                      ))}
                      <span class="extremos" aria-hidden="true">
                        <span>Nada</span>
                        <span>Mucho</span>
                      </span>
                    </div>
                  </fieldset>
                </li>
              ))}
            </ol>
          </section>
        ))
      }

      <div class="navegacion">
        <button type="button" id="anterior" disabled>Anterior</button>
        <button type="submit" class="principal" id="siguiente">Siguiente</button>
      </div>

      <div class="pie-test">
        <p class="guardado">Se guarda automáticamente en este navegador.</p>
        <button type="button" id="reiniciar">Reiniciar</button>
      </div>
    </form>

    <section id="resultado" class="resultado" aria-labelledby="resultado-titulo" tabindex="-1" hidden>
      <h2 id="resultado-titulo">Tu resultado</h2>

      <div class="perfil" id="perfil">
        <p class="perfil__etiqueta" id="perfil-etiqueta"></p>
        <p class="perfil__mensaje" id="perfil-mensaje"></p>
        <p class="perfil__prioridades" id="perfil-prioridades" hidden></p>
      </div>

      <figure class="mapa" id="mapa" hidden>
        <figcaption>
          <strong>Mapa de cercanía</strong>
          <span class="ayuda">
            Cuanto más cerca dos puntos, más coinciden sus respuestas. Los partidos se colocan según cuánto coinciden sus
            propuestas entre sí, y tu punto según tu afinidad con cada uno. Los ejes no significan nada (ni izquierda ni
            derecha): solo cuentan las distancias. Con pocas preguntas en común, la posición es aproximada.
          </span>
        </figcaption>
        <svg id="mapa-svg" viewBox="0 0 600 420" role="img" aria-labelledby="mapa-desc">
          <desc id="mapa-desc"></desc>
        </svg>
      </figure>

      <div class="tarjeta" id="tarjeta">
        <button type="button" id="tarjeta-boton">Compartir imagen</button>
        <p class="ayuda" id="tarjeta-aviso" aria-live="polite"></p>
      </div>

      <p class="prosa ayuda" id="resumen"></p>
      <p class="prosa ayuda">
        Porcentaje del peso de las respuestas que coincide con las propuestas de cada partido, contando solo las preguntas
        en las que ese partido tiene alguna propuesta. Los partidos aparecen en el orden fijo de la web, no ordenados por
        el resultado. Para señalar al más cercano solo cuentan los partidos con propuestas en al menos la mitad del peso.
      </p>

      <ul class="afinidad">
        {
          partidos.map((p) => (
            <li data-partido={p.id}>
              <div class="afinidad__cabecera">
                <strong>{p.data.nombre_corto}</strong>
                <span class="ambito">{p.data.ambito.etiqueta}</span>
              </div>
              <div class="afinidad__fila">
                <span class="barra" aria-hidden="true">
                  <span />
                </span>
                <span class="pct" />
              </div>
              <p class="cobertura" />
            </li>
          ))
        }
      </ul>

      <details class="detalle">
        <summary>Afinidad por tema</summary>
        <div class="tabla">
          <table>
            <caption class="sr-only">Porcentaje de coincidencia por tema y partido</caption>
            <thead>
              <tr>
                <th scope="col">Tema</th>
                {partidos.map((p) => <th scope="col">{p.data.nombre_corto}</th>)}
              </tr>
            </thead>
            <tbody>
              {
                temasTest.map((t) => (
                  <tr data-tema={t.id}>
                    <th scope="row">{t.data.nombre}</th>
                    {partidos.map((p) => (
                      <td data-partido={p.id} />
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="ayuda">«—»: no cuenta ninguna pregunta del tema con propuesta de ese partido.</p>
      </details>

      <details class="detalle">
        <summary>Qué partido propone cada respuesta</summary>
        <ol class="claves">
          {
            preguntas.map((p, i) => (
              <li data-id={p.id}>
                <p class="clave__pregunta">
                  {i + 1}. {p.data.pregunta} <span class="clave__importancia" />
                </p>
                <ul>
                  {p.data.opciones.map((o, j) => (
                    <li data-opcion={j}>
                      <p>
                        <span class="sr-only">Respuesta {letra(j)}: </span>
                        {o.texto} <strong class="tuya" hidden />
                      </p>
                      <ul class="fuentes">
                        {o.partidos.map(({ partido, fuente: idFuente, pagina }) => {
                          const f = fuente(idFuente.id);
                          return (
                            <li>
                              <span class="clave__partido">{nombre.get(partido.id) ?? partido.id}:</span>{' '}
                              <a href={urlPropuesta(f, pagina)} rel="noopener">
                                {f.data.titulo}, {localizador(pagina)}
                              </a>
                              <AvisoConvocatoria fuente={f} />
                            </li>
                          );
                        })}
                      </ul>
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </details>

      <div class="acciones" id="acciones-propias">
        <button type="button" id="volver">Cambiar respuestas</button>
      </div>

      <section class="compartir" id="compartir" aria-labelledby="compartir-titulo">
        <h3 id="compartir-titulo">Compartir el resultado</h3>
        <p class="ayuda">
          Se crea un enlace con tus respuestas dentro. No se guarda en ningún servidor: quien tenga el enlace verá este
          resultado.
        </p>
        <form id="compartir-form" class="compartir__fila">
          <label for="compartir-nombre">Tu nombre o pseudónimo</label>
          <input id="compartir-nombre" type="text" maxlength={NOMBRE_MAX} autocomplete="nickname" required />
          <button type="submit" class="principal">Crear enlace</button>
        </form>
        <div class="compartir__fila" id="compartir-enlace" hidden>
          <label for="compartir-url">Enlace</label>
          <input id="compartir-url" type="url" readonly />
          <button type="button" id="copiar">Copiar</button>
          <p class="ayuda" id="copiado" aria-live="polite"></p>
        </div>
      </section>
    </section>
  </div>
</Base>

<script is:inline type="application/json" id="datos-test" set:html={JSON.stringify(cliente)} />

<script>
  import type { DatosCliente } from '../lib/test';
  import { mapa, perfil, prioridades, type AfinidadPartido, type Perfil } from '../lib/test-perfil';
  import {
    CLAVE_ESTADO,
    CLAVE_PASO,
    IMPORTANCIA_INICIAL,
    PREFIJO_COMPARTIR,
    codificar,
    decodificar,
    progreso,
    type Estado,
  } from '../lib/test-estado';

  const datos = JSON.parse(document.getElementById('datos-test')?.textContent ?? '{}') as DatosCliente;
  const form = document.querySelector<HTMLFormElement>('#test');
  const resultado = document.querySelector<HTMLElement>('#resultado');
  const intro = document.querySelector<HTMLElement>('.intro');
  if (!form || !resultado) throw new Error('Faltan elementos del test');
  const pasos = [...form.querySelectorAll<HTMLElement>('.paso')];
  const nombrePartido = (id: string): string => datos.nombres[id] ?? id;

  const bloque = (id: string): HTMLElement | null => form.querySelector(`.pregunta[data-id="${CSS.escape(id)}"]`);

  const leer = (): Estado =>
    Object.fromEntries(
      datos.preguntas.map(({ id }) => {
        const valor = (nombre: string) =>
          form.querySelector<HTMLInputElement>(`input[name="${CSS.escape(nombre)}"]:checked`)?.value;
        const r = valor(`r-${id}`);
        return [
          id,
          { importancia: Number(valor(`i-${id}`) ?? IMPORTANCIA_INICIAL), respuesta: r === undefined ? null : Number(r) },
        ];
      }),
    );

  // — Páginas: una por tema —

  let actual = 0;
  const anterior = document.querySelector<HTMLButtonElement>('#anterior');
  const siguiente = document.querySelector<HTMLButtonElement>('#siguiente');
  const textoPaso = document.querySelector<HTMLElement>('#paso-texto');

  const idsDe = (paso: HTMLElement): string[] =>
    [...paso.querySelectorAll<HTMLElement>('.pregunta')].map((el) => el.dataset.id ?? '');

  /** Preguntas de la página que siguen sin respuesta. */
  const faltanEn = (paso: HTMLElement, estado: Estado): string[] =>
    idsDe(paso).filter((id) => (estado[id]?.respuesta ?? null) === null);

  const irA = (k: number, enfocar = true): void => {
    actual = Math.min(Math.max(k, 0), pasos.length - 1);
    pasos.forEach((paso, i) => {
      paso.hidden = i !== actual;
    });
    if (anterior) anterior.disabled = actual === 0;
    if (siguiente) siguiente.textContent = actual === pasos.length - 1 ? 'Ver mi resultado' : 'Siguiente';
    if (textoPaso) textoPaso.textContent = `Tema ${actual + 1} de ${pasos.length}`;
    try {
      localStorage.setItem(CLAVE_PASO, String(actual));
    } catch {
      /* almacenamiento no disponible */
    }
    if (!enfocar) return;
    form.scrollIntoView({ block: 'start' });
    pasos[actual]?.querySelector<HTMLElement>('.paso__tema')?.focus({ preventScroll: true });
  };

  /** Marca lo que falta en la página; devuelve si se puede seguir. */
  const validar = (paso: HTMLElement): boolean => {
    const faltan = faltanEn(paso, leer());
    for (const id of idsDe(paso)) bloque(id)?.classList.toggle('pregunta--falta', faltan.includes(id));
    const aviso = paso.querySelector<HTMLElement>('.falta');
    if (aviso) aviso.hidden = faltan.length === 0;
    if (faltan.length > 0) {
      const primera = bloque(faltan[0] ?? '');
      primera?.scrollIntoView({ block: 'center' });
      primera?.querySelector<HTMLInputElement>('.opciones input')?.focus({ preventScroll: true });
    }
    return faltan.length === 0;
  };

  anterior?.addEventListener('click', () => irA(actual - 1));

  // — Guardar en este navegador (opcional; si falla, el test funciona igual) —

  const guardar = (): void => {
    try {
      localStorage.setItem(CLAVE_ESTADO, JSON.stringify(leer()));
    } catch {
      /* almacenamiento no disponible */
    }
  };

  const restaurar = (): void => {
    let guardado: Estado = {};
    try {
      guardado = JSON.parse(localStorage.getItem(CLAVE_ESTADO) ?? '{}') as Estado;
    } catch {
      return;
    }
    for (const { id } of datos.preguntas) {
      const g = guardado[id];
      // Las versiones anteriores guardaban importancia 0 para «no cuenta»: esa pregunta se queda sin responder.
      if (!g || g.importancia < 1) continue;
      const marcar = (nombre: string, valor: number) => {
        const input = form.querySelector<HTMLInputElement>(`input[name="${CSS.escape(nombre)}"][value="${valor}"]`);
        if (input) input.checked = true;
      };
      marcar(`i-${id}`, g.importancia);
      if (g.respuesta !== null) marcar(`r-${id}`, g.respuesta);
    }
  };

  const textoProgreso = document.querySelector<HTMLElement>('#progreso');
  const barraProgreso = document.querySelector<HTMLElement>('#progreso-barra');
  const pintarProgreso = (): void => {
    const { respondidas, total } = progreso(leer());
    if (textoProgreso) textoProgreso.textContent = `${respondidas} de ${total} preguntas`;
    if (barraProgreso) {
      barraProgreso.setAttribute('aria-valuenow', String(respondidas));
      const relleno = barraProgreso.querySelector<HTMLElement>('span');
      if (relleno) relleno.style.width = `${total > 0 ? (100 * respondidas) / total : 0}%`;
    }
  };

  restaurar();
  pintarProgreso();
  try {
    irA(Number(localStorage.getItem(CLAVE_PASO) ?? 0) || 0, false);
  } catch {
    irA(0, false);
  }

  form.addEventListener('change', (e) => {
    const id = e.target instanceof HTMLInputElement ? e.target.closest<HTMLElement>('.pregunta')?.dataset.id : undefined;
    if (id) {
      if (leer()[id]?.respuesta !== null) bloque(id)?.classList.remove('pregunta--falta');
      const paso = pasos[actual];
      const aviso = paso?.querySelector<HTMLElement>('.falta');
      if (paso && aviso && faltanEn(paso, leer()).length === 0) aviso.hidden = true;
    }
    guardar();
    pintarProgreso();
  });

  document.querySelector('#reiniciar')?.addEventListener('click', () => {
    if (!confirm('¿Borrar todas tus respuestas y empezar de nuevo?')) return;
    form.reset();
    pintarProgreso();
    try {
      localStorage.removeItem(CLAVE_ESTADO);
    } catch {
      /* almacenamiento no disponible */
    }
    datos.preguntas.forEach(({ id }) => bloque(id)?.classList.remove('pregunta--falta'));
    form.querySelectorAll<HTMLElement>('.falta').forEach((el) => {
      el.hidden = true;
    });
    irA(0);
  });

  document.querySelector('#volver')?.addEventListener('click', () => {
    resultado.hidden = true;
    form.hidden = false;
    if (intro) intro.hidden = false;
    irA(0);
  });

  // — Cálculo —

  interface Suma {
    acierto: number;
    peso: number;
    preguntas: number;
  }

  const vacia = (): Suma => ({ acierto: 0, peso: 0, preguntas: 0 });
  const pct = (s: Suma): number | null => (s.peso > 0 ? Math.round((100 * s.acierto) / s.peso) : null);

  const calcular = (estado: Estado) => {
    const global = new Map(datos.partidos.map((p) => [p, vacia()]));
    const porTema = new Map<string, Map<string, Suma>>();
    let pesoTotal = 0;
    let cuentan = 0;
    for (const q of datos.preguntas) {
      const { importancia, respuesta } = estado[q.id] ?? { importancia: IMPORTANCIA_INICIAL, respuesta: null };
      if (respuesta === null) continue;
      pesoTotal += importancia;
      cuentan += 1;
      const elegida = new Set(q.opciones[respuesta] ?? []);
      const tema = porTema.get(q.tema) ?? new Map(datos.partidos.map((p) => [p, vacia()]));
      porTema.set(q.tema, tema);
      for (const partido of q.opciones.flat()) {
        for (const s of [global.get(partido), tema.get(partido)]) {
          if (!s) continue;
          s.peso += importancia;
          s.preguntas += 1;
          if (elegida.has(partido)) s.acierto += importancia;
        }
      }
    }
    return { global, porTema, pesoTotal, cuentan };
  };

  // — Perfil y mapa de cercanía —

  let ultimo: { perfil: Perfil; prioridades: string[]; puntos: ReturnType<typeof mapa> } | null = null;

  const SVG = 'http://www.w3.org/2000/svg';
  const ANCHO = 600;
  const ALTO = 420;
  const MARGEN = 56;

  /** Lleva los puntos del mapa al rectángulo dado, con la misma escala en los dos ejes. */
  const encajar = (
    puntos: NonNullable<ReturnType<typeof mapa>>,
    ancho: number,
    alto: number,
    margen: number,
  ): { id: string; x: number; y: number }[] => {
    const todos = [...puntos.partidos, puntos.persona];
    const xs = todos.map((p) => p.x);
    const ys = todos.map((p) => p.y);
    const [x0, x1, y0, y1] = [Math.min(...xs), Math.max(...xs), Math.min(...ys), Math.max(...ys)];
    const escala = Math.min((ancho - 2 * margen) / (x1 - x0 || 1), (alto - 2 * margen) / (y1 - y0 || 1));
    const dx = (ancho - escala * (x1 - x0)) / 2;
    const dy = (alto - escala * (y1 - y0)) / 2;
    return todos.map((p) => ({ id: p.id, x: dx + escala * (p.x - x0), y: dy + escala * (p.y - y0) }));
  };

  const pintarMapa = (puntos: ReturnType<typeof mapa>, nombre?: string): void => {
    const figura = document.querySelector<HTMLElement>('#mapa');
    const svg = document.querySelector<SVGSVGElement>('#mapa-svg');
    const desc = svg?.querySelector('desc');
    if (!figura || !svg || !desc) return;
    figura.hidden = puntos === null;
    svg.querySelectorAll('g').forEach((g) => g.remove());
    if (!puntos) return;
    const persona = nombre ?? 'Tú';
    for (const p of encajar(puntos, ANCHO, ALTO, MARGEN)) {
      const tuyo = p.id === 'persona';
      const g = document.createElementNS(SVG, 'g');
      g.setAttribute('class', tuyo ? 'mapa__persona' : 'mapa__partido');
      const c = document.createElementNS(SVG, 'circle');
      c.setAttribute('cx', String(p.x));
      c.setAttribute('cy', String(p.y));
      c.setAttribute('r', tuyo ? '10' : '7');
      const t = document.createElementNS(SVG, 'text');
      const derecha = p.x < ANCHO - 120;
      t.setAttribute('x', String(p.x + (derecha ? 14 : -14)));
      t.setAttribute('y', String(p.y + 5));
      t.setAttribute('text-anchor', derecha ? 'start' : 'end');
      t.textContent = tuyo ? persona : nombrePartido(p.id);
      g.append(c, t);
      svg.append(g);
    }
    const cercanos = [...puntos.partidos]
      .sort(
        (a, b) =>
          Math.hypot(a.x - puntos.persona.x, a.y - puntos.persona.y) -
          Math.hypot(b.x - puntos.persona.x, b.y - puntos.persona.y),
      )
      .map((p) => nombrePartido(p.id));
    desc.textContent = `Partidos en el mapa, del más cercano al más lejano al punto de ${persona === 'Tú' ? 'tus respuestas' : persona}: ${cercanos.join(', ')}.`;
  };

  const pintarPerfil = (estado: Estado, afinidades: AfinidadPartido[], nombre?: string): void => {
    const p = perfil(afinidades, estado, nombrePartido);
    const temas = prioridades(estado, datos.preguntas, Object.keys(datos.temas)).map((t) => datos.temas[t] ?? t);
    const puntos = mapa(datos.preguntas, afinidades);
    ultimo = { perfil: p, prioridades: temas, puntos };
    const etiqueta = document.querySelector<HTMLElement>('#perfil-etiqueta');
    const mensaje = document.querySelector<HTMLElement>('#perfil-mensaje');
    const lista = document.querySelector<HTMLElement>('#perfil-prioridades');
    if (etiqueta) etiqueta.textContent = p.etiqueta;
    if (mensaje) mensaje.textContent = nombre ? `${nombre}: ${p.mensaje}` : p.mensaje;
    if (lista) {
      lista.hidden = temas.length === 0;
      lista.textContent = `${nombre ? `Lo que más le importa a ${nombre}` : 'Lo que más te importa'}: ${temas.join(', ')}.`;
    }
    pintarMapa(puntos, nombre);
  };

  // — Imagen para compartir (se dibuja en el navegador; no sale de él hasta que la compartes) —

  const lineas = (ctx: CanvasRenderingContext2D, texto: string, ancho: number): string[] => {
    const salida: string[] = [];
    let linea = '';
    for (const palabra of texto.split(' ')) {
      const prueba = linea ? `${linea} ${palabra}` : palabra;
      if (ctx.measureText(prueba).width > ancho && linea) {
        salida.push(linea);
        linea = palabra;
      } else linea = prueba;
    }
    if (linea) salida.push(linea);
    return salida;
  };

  const dibujarTarjeta = (): HTMLCanvasElement | null => {
    if (!ultimo) return null;
    const W = 1080;
    const H = 1350;
    const lienzo = document.createElement('canvas');
    lienzo.width = W;
    lienzo.height = H;
    const ctx = lienzo.getContext('2d');
    if (!ctx) return null;
    const fuente = getComputedStyle(document.body).fontFamily;
    const [texto, apagado, acento, regla] = ['#0a0a0b', '#52525b', '#2f3fc4', '#e4e4e7'];
    ctx.fillStyle = '#fafafa';
    ctx.fillRect(0, 0, W, H);
    const m = 80;
    let y = m + 40;
    ctx.fillStyle = apagado;
    ctx.font = `600 34px ${fuente}`;
    ctx.fillText('Test de afinidad · Elecciones 29-N-2026', m, y);
    y += 90;
    ctx.fillStyle = acento;
    ctx.font = `700 76px ${fuente}`;
    ctx.fillText(ultimo.perfil.etiqueta, m, y);
    y += 70;
    ctx.fillStyle = texto;
    ctx.font = `400 40px ${fuente}`;
    for (const l of lineas(ctx, ultimo.perfil.mensaje, W - 2 * m)) {
      ctx.fillText(l, m, y);
      y += 54;
    }
    if (ultimo.prioridades.length > 0) {
      y += 16;
      ctx.fillStyle = apagado;
      ctx.font = `400 32px ${fuente}`;
      for (const l of lineas(ctx, `Lo que más me importa: ${ultimo.prioridades.join(', ')}.`, W - 2 * m)) {
        ctx.fillText(l, m, y);
        y += 44;
      }
    }
    const pie = H - m;
    if (ultimo.puntos) {
      const top = y + 20;
      const alto = pie - 110 - top;
      ctx.strokeStyle = regla;
      ctx.lineWidth = 2;
      ctx.strokeRect(m, top, W - 2 * m, alto);
      for (const p of encajar(ultimo.puntos, W - 2 * m, alto, 90)) {
        const tuyo = p.id === 'persona';
        const x = m + p.x;
        const py = top + p.y;
        ctx.beginPath();
        ctx.arc(x, py, tuyo ? 18 : 12, 0, 2 * Math.PI);
        ctx.fillStyle = tuyo ? acento : '#8b8b94';
        ctx.fill();
        ctx.fillStyle = tuyo ? acento : texto;
        ctx.font = `${tuyo ? 700 : 500} 32px ${fuente}`;
        const derecha = p.x < W - 2 * m - 220;
        ctx.textAlign = derecha ? 'left' : 'right';
        ctx.fillText(tuyo ? 'Yo' : nombrePartido(p.id), x + (derecha ? 26 : -26), py + 11);
        ctx.textAlign = 'left';
      }
    }
    ctx.fillStyle = apagado;
    ctx.font = `400 28px ${fuente}`;
    ctx.fillText('Coincidencia con propuestas publicadas, no recomendación de voto.', m, pie - 40);
    ctx.fillStyle = acento;
    ctx.font = `600 30px ${fuente}`;
    ctx.fillText(`Haz el test: ${location.host}/test`, m, pie);
    return lienzo;
  };

  document.querySelector('#tarjeta-boton')?.addEventListener('click', async () => {
    const aviso = document.querySelector<HTMLElement>('#tarjeta-aviso');
    const lienzo = dibujarTarjeta();
    if (!lienzo) return;
    const blob = await new Promise<Blob | null>((ok) => lienzo.toBlob(ok, 'image/png'));
    if (!blob) return;
    const archivo = new File([blob], 'mi-afinidad-29n.png', { type: 'image/png' });
    if (navigator.canShare?.({ files: [archivo] })) {
      try {
        await navigator.share({ files: [archivo], title: 'Mi test de afinidad 29-N' });
        return;
      } catch (e) {
        if (e instanceof DOMException && e.name === 'AbortError') return;
      }
    }
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = archivo.name;
    a.click();
    URL.revokeObjectURL(url);
    if (aviso) aviso.textContent = 'Imagen descargada.';
  });

  /** `nombre` solo en un resultado compartido. */
  const mostrar = (estado: Estado, nombre?: string): void => {
    const ajeno = nombre !== undefined;
    const titulo = resultado.querySelector<HTMLElement>('#resultado-titulo');
    if (titulo) titulo.textContent = ajeno ? `Resultado de ${nombre}` : 'Tu resultado';
    for (const id of ['#acciones-propias', '#compartir', '#tarjeta'])
      resultado.querySelector<HTMLElement>(id)?.toggleAttribute('hidden', ajeno);
    const { global, porTema, pesoTotal, cuentan } = calcular(estado);
    const afinidades: AfinidadPartido[] = datos.partidos.map((partido) => {
      const s = global.get(partido) ?? vacia();
      return { partido, pct: pct(s), parte: pesoTotal > 0 ? s.peso / pesoTotal : 0 };
    });
    pintarPerfil(estado, afinidades, nombre);
    const resumen = resultado.querySelector<HTMLElement>('#resumen');
    if (resumen)
      resumen.textContent =
        cuentan === 0
          ? 'No hay ninguna pregunta respondida: no hay nada que calcular.'
          : `Cuentan ${cuentan} de ${datos.preguntas.length} preguntas.`;

    for (const partido of datos.partidos) {
      const li = resultado.querySelector<HTMLElement>(`.afinidad [data-partido="${CSS.escape(partido)}"]`);
      const s = global.get(partido);
      if (!li || !s) continue;
      const valor = pct(s);
      const barra = li.querySelector<HTMLElement>('.barra > span');
      const texto = li.querySelector<HTMLElement>('.pct');
      const cobertura = li.querySelector<HTMLElement>('.cobertura');
      if (barra) barra.style.width = `${valor ?? 0}%`;
      li.classList.toggle('afinidad--sin', valor === null);
      if (texto) texto.textContent = valor === null ? 'Sin datos' : `${valor} %`;
      if (cobertura) {
        const parte = pesoTotal > 0 ? s.peso / pesoTotal : 0;
        cobertura.textContent =
          valor === null
            ? 'No tiene propuestas publicadas sobre las preguntas que cuentan.'
            : `Calculado sobre ${s.preguntas} de ${cuentan} preguntas (${Math.round(100 * parte)} % del peso).` +
              (parte < 0.5 ? ' Con tan pocas preguntas, el porcentaje es poco representativo.' : '');
      }
    }

    for (const fila of resultado.querySelectorAll<HTMLTableRowElement>('tbody tr')) {
      const tema = porTema.get(fila.dataset.tema ?? '');
      for (const celda of fila.querySelectorAll<HTMLTableCellElement>('td')) {
        const s = tema?.get(celda.dataset.partido ?? '');
        const valor = s ? pct(s) : null;
        celda.textContent = valor === null ? '—' : `${valor} %`;
      }
    }

    for (const q of datos.preguntas) {
      const li = resultado.querySelector<HTMLElement>(`.claves > li[data-id="${CSS.escape(q.id)}"]`);
      if (!li) continue;
      const { importancia, respuesta } = estado[q.id] ?? { importancia: IMPORTANCIA_INICIAL, respuesta: null };
      const cuenta = respuesta !== null;
      const etiqueta = li.querySelector<HTMLElement>('.clave__importancia');
      if (etiqueta) etiqueta.textContent = cuenta ? `(importancia ${importancia})` : '(sin responder)';
      for (const op of li.querySelectorAll<HTMLElement>('[data-opcion]')) {
        const tuya = cuenta && Number(op.dataset.opcion) === respuesta;
        op.classList.toggle('elegida', tuya);
        const marca = op.querySelector<HTMLElement>('.tuya');
        if (marca) {
          marca.hidden = !tuya;
          marca.textContent = ajeno ? '(respuesta elegida)' : '(tu respuesta)';
        }
      }
    }

    resultado.hidden = false;
    if (ajeno) return;
    form.hidden = true;
    if (intro) intro.hidden = true;
    resultado.scrollIntoView();
    resultado.focus({ preventScroll: true });
  };

  // — Compartir: las respuestas van en el fragmento de la URL, que no llega al servidor —

  const formCompartir = document.querySelector<HTMLFormElement>('#compartir-form');
  const campoNombre = document.querySelector<HTMLInputElement>('#compartir-nombre');
  const bloqueEnlace = document.querySelector<HTMLElement>('#compartir-enlace');
  const campoUrl = document.querySelector<HTMLInputElement>('#compartir-url');
  const copiado = document.querySelector<HTMLElement>('#copiado');

  formCompartir?.addEventListener('submit', (e) => {
    e.preventDefault();
    const nombre = campoNombre?.value.trim() ?? '';
    if (!nombre || !campoUrl || !bloqueEnlace) return;
    campoUrl.value = `${location.origin}${location.pathname}${PREFIJO_COMPARTIR}${codificar(nombre, leer())}`;
    bloqueEnlace.hidden = false;
    if (copiado) copiado.textContent = '';
    campoUrl.select();
  });

  // Si se cambia el nombre, el enlace anterior ya no corresponde.
  campoNombre?.addEventListener('input', () => {
    if (bloqueEnlace) bloqueEnlace.hidden = true;
  });

  document.querySelector('#copiar')?.addEventListener('click', async () => {
    if (!campoUrl || !copiado) return;
    try {
      await navigator.clipboard.writeText(campoUrl.value);
      copiado.textContent = 'Enlace copiado.';
    } catch {
      campoUrl.select();
      copiado.textContent = 'Selecciona el enlace y cópialo.';
    }
  });

  // — Resultado compartido (`/test#r=…`): solo lectura, no toca las respuestas guardadas —

  const verCompartido = (): boolean => {
    if (!location.hash.startsWith(PREFIJO_COMPARTIR)) return false;
    const compartido = decodificar(location.hash.slice(PREFIJO_COMPARTIR.length), datos.preguntas);
    const aviso = document.querySelector<HTMLElement>('#compartido');
    if (!compartido || !aviso) return false;
    const nombre = compartido.nombre || 'alguien';
    const destino = aviso.querySelector<HTMLElement>('#compartido-nombre');
    if (destino) destino.textContent = nombre;
    const descartadas = aviso.querySelector<HTMLElement>('#compartido-descartadas');
    if (descartadas && compartido.descartadas > 0) {
      descartadas.hidden = false;
      descartadas.textContent =
        compartido.descartadas === 1
          ? 'Una respuesta del enlace corresponde a una pregunta que ha cambiado o ya no está en el test y no cuenta.'
          : `${compartido.descartadas} respuestas del enlace corresponden a preguntas que han cambiado o ya no están en el test y no cuentan.`;
    }
    aviso.hidden = false;
    document.querySelector<HTMLElement>('.intro')?.setAttribute('hidden', '');
    form.hidden = true;
    mostrar(compartido.estado, nombre);
    return true;
  };

  verCompartido();
  // Un enlace compartido abierto con /test ya cargado solo cambia el fragmento.
  window.addEventListener('hashchange', () => {
    if (location.hash.startsWith(PREFIJO_COMPARTIR)) location.reload();
  });

  // Enter o «Siguiente»: avanza si la página está completa; en la última, muestra el resultado.
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const paso = pasos[actual];
    if (!paso || !validar(paso)) return;
    if (actual < pasos.length - 1) {
      irA(actual + 1);
      return;
    }
    // Por si se restauró un estado con huecos en páginas anteriores.
    const estado = leer();
    const pendiente = pasos.findIndex((p) => faltanEn(p, estado).length > 0);
    if (pendiente >= 0) {
      irA(pendiente);
      const p = pasos[pendiente];
      if (p) validar(p);
      return;
    }
    mostrar(estado);
  });
</script>

